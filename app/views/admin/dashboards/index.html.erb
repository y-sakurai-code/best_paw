<div class="container-fluid py-4">
  <div class="d-flex align-items-center mb-4">
    <i class="fa-solid fa-gauge-high fa-2x text-secondary me-3"></i>
    <h2 class="fw-bold mb-0">管理ダッシュボード</h2>
  </div>

  <%# カード1：全ユーザー数 %>
  <div class="row g-3 mb-5">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm rounded-3 p-3 h-100">
        <div class="text-muted small fw-bold mb-1"><i class="fa-solid fa-users me-1"></i> 全ユーザー数</div>
        <div class="h3 fw-bold mb-0"><%= @total_user_count %> <small class="fs-6">名</small></div>
      </div>
    </div>

    <%# カード2：本日の新規等労苦者数 %>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm rounded-3 p-3 h-100">
        <div class="text-muted small fw-bold mb-1"><i class="fa-solid fa-user-plus me-1"></i> 本日の新規登録</div>
        <div class="h3 fw-bold mb-0"><%= @today_user_count %> <small class="fs-6">名</small></div>
      </div>
    </div>

    <%# カード3：総レビュー数 %>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm rounded-3 p-3 h-100">
        <div class="text-muted small fw-bold mb-1"><i class="fa-solid fa-pen-to-square me-1"></i> 総レビュー数</div>
        <div class="h3 fw-bold mb-0"><%= @total_review_count %> <small class="fs-6">件</small></div>
      </div>
    </div>
  </div>

  <%# 最新のレビュー10件 %>
  <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
      <h5 class="fw-bold mb-0"><i class="fa-solid fa-clock-rotate-left me-2 text-secondary"></i>最新のレビュー（10件）</h5>
    </div>
    
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-4" style="width: 15%;">投稿日</th>
            <th style="width: 20%;">ユーザー</th>
            <th>レビュータイトル</th>
            <th class="text-end pe-4">操作</th>
          </tr>
        </thead>
        <tbody>
          <% @recent_reviews.each do |review| %>
            <tr>
              <td class="ps-4 text-secondary small"><%= review.created_at.strftime("%Y/%m/%d") %></td>
              <td class="fw-bold"><%= review.user.name %></td>
              <td><%= truncate(review.title, length: 30) %></td>
              <td class="text-end pe-4">
                <%= link_to admin_reviews_management_path(review), class: "btn btn-outline-dark btn-sm rounded-pill px-3" do %>
                  <i class="fa-solid fa-magnifying-glass me-1"></i>詳細
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>