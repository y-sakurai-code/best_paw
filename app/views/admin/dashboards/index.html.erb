<h1>管理ダッシュボード</h1>

<hr>

<h3>統計データ</h3>
<div style="display: flex; gap: 20px; margin-bottom: 30px;">
  <div style="border: 1px solid #ccc; padding: 15px; border-radius: 8px;">
    <strong>全ユーザー数</strong><br>
    <span style="font-size: 24px;"><%= @total_user_count %> 名</span>
  </div>

  <div style="border: 1px solid #ccc; padding: 15px; border-radius: 8px;">
    <strong>本日の新規登録</strong><br>
    <span style="font-size: 24px;"><%= @today_user_count %> 名</span>
  </div>

  <div style="border: 1px solid #ccc; padding: 15px; border-radius: 8px;">
    <strong>アイテム総数</strong><br>
    <span style="font-size: 24px;"><%= @total_item_count %> 点</span>
  </div>

  <div style="border: 1px solid #ccc; padding: 15px; border-radius: 8px;">
    <strong>総レビュー数</strong><br>
    <span style="font-size: 24px;"><%= @total_review_count %> 件</span>
  </div>
</div>

<hr>

<h3>最新のレビュー（5件）</h3>
<table style="width: 100%; border-collapse: collapse;">
  <thead>
    <tr style="border-bottom: 2px solid #dee2e6;">
      <th style="text-align: left; padding: 10px;">投稿日</th>
      <th style="text-align: left; padding: 10px;">ユーザー</th>
      <th style="text-align: left; padding: 10px;">レビュータイトル</th>
    </tr>
  </thead>
  <tbody>
    <% @recent_reviews.each do |review| %>
      <tr style="border-bottom: 1px solid #eee;">
        <td style="padding: 10px;"><%= review.created_at.strftime("%Y/%m/%d %H:%M") %></td>
        <td style="padding: 10px;"><%= review.user.name %></td>
        <td style="padding: 10px;"><%= review.title %></td>
      </tr>
    <% end %>
  </tbody>
</table>