<%= form_with model: [:admin, genre], local: true do |f| %>
  <div class="form-group">
    <%= f.label :name, "ジャンル名" %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>
  <div class="mt-3">
    <%= f.submit (genre.new_record? ? "登録" : "更新"), class: "btn btn-success" %>
  </div>
<% end %>