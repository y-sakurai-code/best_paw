<h2>ジャンル管理</h2>

<button type="button" class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#newGenreModal">
  新しいジャンルを追加
</button>

<table class="table table-hover">
  <thead>
    <tr>
      <th>ジャンル名</th>
      <th>操作</th>
    </tr>
  </thead>
  <tbody>
    <% @genres.each do |genre| %>
      <tr>
        <td><%= genre.name %></td>
        <td>
          <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editModal-<%= genre.id %>">
            編集
          </button>

          <%= link_to '削除', admin_genre_path(genre), method: :delete, 
                data: { confirm: "ジャンル「#{genre.name}」を削除しますか？" }, 
                class: "btn btn-sm btn-outline-danger" %>
        </td>
      </tr>

      <div class="modal fade" id="editModal-<%= genre.id %>" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title">ジャンル編集</h5>
              <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
              <%= render 'form', genre: genre %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </tbody>
</table>

<div class="modal fade" id="newGenreModal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">新規登録</h5></div>
      <div class="modal-body">
        <%= render 'form', genre: @genre %>
      </div>
    </div>
  </div>
</div>