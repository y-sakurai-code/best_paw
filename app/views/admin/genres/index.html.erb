<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-7">
      
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h5 fw-bold mb-0">ジャンル管理</h2>
        <%= link_to new_admin_genre_path, class: "btn btn-dark btn-sm px-3 fw-bold shadow-sm" do %>
          <i class="fa-solid fa-plus me-1"></i>新規ジャンルを追加
        <% end %>
      </div>

      <div class="bg-white border rounded-1 overflow-hidden">
        <table class="table table-hover align-middle mb-0">
          <thead class="bg-light">
            <tr>
              <th class="ps-4 py-2 text-secondary small fw-bold">ジャンル名</th>
              <th class="pe-4 py-2 text-end text-secondary small fw-bold" style="width: 160px;">操作</th>
            </tr>
          </thead>
          <tbody>
            <% if @genres.any? %>
              <% @genres.each do |genre| %>
                <tr>
                  <td class="ps-4 text-dark small fw-bold"><%= genre.name %></td>
                  <td class="pe-4 text-end">
                    <div class="btn-group">
                      <%= link_to edit_admin_genre_path(genre), class: "btn btn-sm btn-outline-secondary border-0" do %>
                        <i class="fa-solid fa-pen-to-square"></i>
                      <% end %>
                      <% # 削除アクション %>
                      <%= link_to admin_genre_path(genre), method: :delete, 
                            data: { confirm: "ジャンル「#{genre.name}」を削除しますか？" }, 
                            class: "btn btn-sm btn-outline-danger border-0" do %>
                        <i class="fa-solid fa-trash-can"></i>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="2" class="text-center py-5 text-muted small">
                  登録されているジャンルはありません
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

    </div>
  </div>
</div>