<h2>商品編集</h2>

<%= form_with model: [:admin, @item] do |f| %>

  <label>商品名</label>
  <%= f.text_field :name, placeholder: "例：わんわんおもちゃ" %>

  <label>ジャンル</label>
  <%= f.collection_select :genre_id, Genre.all, :id, :name, { include_blank: "-- 選択してください --" }, { class: "form-control" } %>

  <label>商品説明文</label>
  <%= f.text_area :introduction, rows: 5 %>

  <label>現在の画像</label><br>
  <% if @item.item_image.attached? %>
    <%= image_tag @item.item_image, size: "100x100" %><br>
  <% end %>
  <%= f.file_field :item_image, accept: "image/*" %>

  <label>想定する犬の大きさ（目安）</label>
  <%= f.select :estimated_dog_size, Item.estimated_dog_sizes.keys, {include_blank: "選択してください"} %>

  <label>販売ステータス</label>
  <%= f.select :is_active, Item.is_actives.keys %>

  <div style="margin-top: 20px;">
    <%= f.submit "変更を保存する" %>
  </div>

<% end %>

<hr>
<%= link_to '詳細に戻る', admin_item_path(@item) %> |
<%= link_to '一覧に戻る', admin_items_path %> |
<%= link_to "削除する", admin_item_path(@item), method: :delete, data: { confirm: "本当に削除しますか？" } %>