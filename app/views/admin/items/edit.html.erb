<div class="container py-4">
  <div class="mb-3">
    <%= link_to admin_item_path(@item), class: "text-decoration-none text-muted small" do %>
      <i class="fa-solid fa-chevron-left me-1"></i>詳細へ戻る
    <% end %>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-7">
      <div class="bg-white p-4 border rounded-3 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h5 class="fw-bold mb-0">商品編集</h5>
          <span class="text-secondary small">ID: #<%= @item.id %></span>
        </div>

        <%= form_with model: [:admin, @item] do |f| %>
          
          <div class="mb-4">
            <%= f.label :item_image, "商品画像", class: "form-label small fw-bold" %>
            <div class="d-flex align-items-center gap-3 p-3 border rounded bg-light">
              <% if @item.item_image.attached? %>
                <%= image_tag @item.item_image, class: "rounded border object-fit-cover", size: "80x80" %>
              <% else %>
                <div class="bg-white border rounded d-flex align-items-center justify-content-center text-muted" style="width: 80px; height: 80px;">
                  <i class="fa-solid fa-image fa-2x"></i>
                </div>
              <% end %>
              <div class="flex-grow-1">
                <%= f.file_field :item_image, accept: "image/*", class: "form-control form-control-sm" %>
                <p class="text-muted small mt-1 mb-0">新しい画像を選択すると差し替わります</p>
              </div>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :name, "商品名", class: "form-label small fw-bold" %>
            <%= f.text_field :name, class: "form-control", placeholder: "商品名を入力" %>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <%= f.label :genre_id, "ジャンル", class: "form-label small fw-bold" %>
              <%= f.collection_select :genre_id, Genre.all, :id, :name, { include_blank: "選択してください" }, { class: "form-select" } %>
            </div>
            <div class="col-md-6">
              <%= f.label :estimated_dog_size, "サイズ目安", class: "form-label small fw-bold" %>
              <%= f.select :estimated_dog_size, Item.estimated_dog_sizes.keys, {include_blank: "選択"}, { class: "form-select" } %>
            </div>
          </div>

          <div class="mb-4">
            <%= f.label :is_active, "販売ステータス", class: "form-label small fw-bold" %>
            <div class="d-flex gap-3 mt-1">
              <% Item.is_actives.keys.each do |key| %>
                <div class="form-check">
                  <%= f.radio_button :is_active, key, class: "form-check-input" %>
                  <%= f.label "is_active_#{key}", key, class: "form-check-label small" %>
                </div>
              <% end %>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :introduction, "商品説明", class: "form-label small fw-bold" %>
            <%= f.text_area :introduction, class: "form-control", rows: 4 %>
          </div>

          <div class="pt-3 border-top d-flex gap-2">
            <%= f.submit "変更を保存する", class: "btn btn-dark fw-bold py-2 flex-grow-1" %>
            <%= link_to "削除", admin_item_path(@item), method: :delete, data: { confirm: "この商品を完全に削除しますか？" }, class: "btn btn-outline-danger py-2 px-3" %>
          </div>

        <% end %>
      </div>
      
      <div class="text-center mt-3">
        <%= link_to "一覧に戻る", admin_items_path, class: "text-muted small text-decoration-none" %>
      </div>
    </div>
  </div>
</div>