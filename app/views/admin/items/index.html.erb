<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold text-dark mb-1">
        <i class="fa-solid fa-boxes-stacked text-secondary me-2"></i>商品管理
      </h2>
      <p class="text-secondary small mb-0">登録済み商品: <span class="fw-bold text-dark"><%= @items.count %></span> 件</p>
    </div>
    <%= link_to new_admin_item_path, class: "btn btn-primary rounded-pill px-4 fw-bold shadow-sm" do %>
      <i class="fa-solid fa-plus me-1"></i>新規登録
    <% end %>
  </div>

  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-light">
          <tr>
            <th class="ps-4 py-3 text-secondary small fw-bold" style="width: 80px;">ID</th>
            <th class="py-3 text-secondary small fw-bold" style="width: 100px;">画像</th>
            <th class="py-3 text-secondary small fw-bold">商品名 / ジャンル</th>
            <th class="py-3 text-secondary small fw-bold" style="width: 150px;">サイズ目安</th>
            <th class="py-3 text-secondary small fw-bold" style="width: 120px;">ステータス</th>
            <th class="pe-4 py-3 text-end text-secondary small fw-bold" style="width: 300px;">操作</th>
          </tr>
        </thead>
        <tbody>
          <% @items.each do |item| %>
            <tr>
              <td class="ps-4 text-secondary small">#<%= item.id %></td>
              <td>
                <% if item.item_image.attached? %>
                  <%= image_tag item.item_image, class: "rounded-3 object-fit-cover border", size: "50x50" %>
                <% else %>
                  <div class="bg-light rounded-3 d-flex align-items-center justify-content-center text-muted small border" style="width: 50px; height: 50px;">
                    <i class="fa-solid fa-image"></i>
                  </div>
                <% end %>
              </td>
              <td>
                <div class="fw-bold text-dark mb-0"><%= item.name %></div>
                <span class="badge bg-secondary-subtle text-secondary fw-normal" style="font-size: 0.7rem;">
                  <%= item.genre&.name || "未分類" %>
                </span>
              </td>
              <td class="text-dark small">
                <i class="fa-solid fa-dog me-1 text-secondary"></i><%= item.estimated_dog_size %>
              </td>
              <td>
                <% if item.is_active %>
                  <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3">
                    販売中
                  </span>
                <% else %>
                  <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-3">
                    停止中
                  </span>
                <% end %>
              </td>
              <td class="pe-4 text-end">
                <div class="btn-group">
                  <%= link_to admin_item_path(item), class: "btn btn-sm btn-outline-secondary px-3 rounded-start-pill" do %>
                    表示
                  <% end %>
                  <%= link_to edit_admin_item_path(item), class: "btn btn-sm btn-outline-secondary px-3" do %>
                    編集
                  <% end %>
                  <%= link_to admin_item_path(item), method: :delete, data: { confirm: "商品を完全に削除しますか？" }, class: "btn btn-sm btn-outline-danger px-3 rounded-end-pill" do %>
                    <i class="fa-solid fa-trash-can"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    
    <% if @items.respond_to?(:total_pages) %>
      <div class="card-footer bg-white border-top-0 py-3">
        <div class="d-flex justify-content-center">
          <%= paginate @items %>
        </div>
      </div>
    <% end %>
  </div>
</div>