<div class="container py-4">
  <div class="mb-3">
    <%= link_to admin_items_path, class: "text-decoration-none text-muted small" do %>
      <i class="fa-solid fa-chevron-left me-1"></i>一覧へ
    <% end %>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-7">
      <div class="bg-white p-4 border rounded-3">
        <h5 class="fw-bold mb-4">商品登録</h5>

        <%= form_with model: [:admin, @item] do |f| %>
          
          <div class="mb-3">
            <%= f.label :item_image, "商品画像", class: "form-label small fw-bold" %>
            <%= f.file_field :item_image, accept: "image/*", class: "form-control form-control-sm" %>
          </div>

          <div class="mb-3">
            <%= f.label :name, "商品名", class: "form-label small fw-bold" %>
            <%= f.text_field :name, class: "form-control", placeholder: "商品名を入力" %>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <%= f.label :genre_id, "ジャンル", class: "form-label small fw-bold" %>
              <%= f.collection_select :genre_id, Genre.all, :id, :name, { include_blank: "選択してください" }, { class: "form-select" } %>
            </div>
            <div class="col-md-6">
              <%= f.label :estimated_dog_size, "サイズ目安", class: "form-label small fw-bold" %>
              <%= f.select :estimated_dog_size, Item.estimated_dog_sizes.keys, {include_blank: "選択"}, { class: "form-select" } %>
            </div>
          </div>

          <div class="mb-4">
            <%= f.label :is_active, "販売ステータス", class: "form-label small fw-bold" %>
            <div class="d-flex gap-3 mt-1">
              <% Item.is_actives.keys.each do |key| %>
                <div class="form-check">
                  <%= f.radio_button :is_active, key, class: "form-check-input" %>
                  <%= f.label "is_active_#{key}", key, class: "form-check-label small" %>
                </div>
              <% end %>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :introduction, "商品説明", class: "form-label small fw-bold" %>
            <%= f.text_area :introduction, class: "form-control", rows: 4 %>
          </div>

          <div class="pt-3 border-top">
            <%= f.submit "保存する", class: "btn btn-dark w-100 fw-bold py-2" %>
          </div>

        <% end %>
      </div>
    </div>
  </div>
</div>