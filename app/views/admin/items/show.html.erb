<div class="container py-4">
  <div class="mb-3">
    <%= link_to admin_items_path, class: "text-decoration-none text-muted small" do %>
      <i class="fa-solid fa-arrow-left me-1"></i>一覧
    <% end %>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="bg-white p-4 border rounded-1">
        
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
          <h2 class="h5 fw-bold mb-0">商品詳細 [ID: <%= @item.id %>]</h2>
        </div>

        <div class="row g-4">
          <div class="col-md-4">
            <% if @item.item_image.attached? %>
              <%= image_tag @item.item_image, class: "img-fluid border rounded", style: "max-height: 200px;" %>
            <% else %>
              <div class="bg-light border rounded d-flex align-items-center justify-content-center text-muted" style="height: 200px;">
                <span class="small">画像なし</span>
              </div>
            <% end %>
          </div>

          <div class="col-md-8">
            <dl class="row small mb-0">
              <dt class="col-4 text-muted">商品名</dt>
              <dd class="col-8 fw-bold"><%= @item.name %></dd>

              <dt class="col-4 text-muted">ジャンル</dt>
              <dd class="col-8"><%= @item.genre&.name %></dd>

              <dt class="col-4 text-muted">サイズ目安</dt>
              <dd class="col-8"><%= @item.estimated_dog_size %></dd>

              <dt class="col-4 text-muted">販売ステータス</dt>
              <dd class="col-8"><%= @item.is_active %></dd>

              <dt class="col-4 text-muted mt-2">商品説明</dt>
              <dd class="col-12 mt-1">
                <div class="p-2 bg-light border-start border-3" style="white-space: pre-wrap;"><%= @item.introduction %></div>
              </dd>
            </dl>
          </div>
        </div>

        <div class="mt-5 pt-3 border-top">
          <%= link_to edit_admin_item_path(@item), class: "btn btn-dark btn-sm px-4 me-2" do %>
            編集する
          <% end %>
          <%= link_to "削除する", admin_item_path(@item), method: :delete, data: { confirm: "削除しますか？" }, class: "btn btn-link text-danger text-decoration-none small" %>
        </div>

      </div>
    </div>
  </div>
</div>