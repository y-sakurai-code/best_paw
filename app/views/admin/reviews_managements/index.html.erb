<div class="py-5 bg-light">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="fw-bold text-danger mb-2">
        <i class="fa-solid fa-user-shield me-2"></i>レビュー管理
      </h2>
      <p class="text-secondary">投稿内容の監視および不適切なデータの管理ページです</p>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
      <% @reviews.each do |review| %>
        <div class="col">
          <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
            
            <div class="position-relative bg-dark-subtle d-flex align-items-center justify-content-center" style="height: 140px;">
              <div class="p-3 text-center">
                <div class="badge bg-secondary mb-2">ID: #<%= review.id %></div>
                <h5 class="fw-bold text-dark mb-1"><%= review.title %></h5>
                <%= render 'public/reviews/static_rate', review: review %>
              </div>

              <span class="position-absolute top-0 end-0 m-3 badge rounded-pill bg-white text-secondary shadow-sm">
                <i class="fa-solid fa-comment me-1"></i><%= review.review_comments.count %>
              </span>
            </div>

            <div class="card-body d-flex flex-column">
              <p class="card-text text-secondary small mb-4 flex-grow-1 line-clamp-2">
                <%= review.body %>
              </p>

              <div class="d-flex justify-content-between align-items-center mt-auto">
                <div class="small text-muted">
                  <i class="fa-solid fa-user-circle me-1"></i><%= review.user.name %>
                </div>

                <div class="btn-group">
                  <%= link_to "詳細", admin_reviews_management_path(id: review.id), class: "btn btn-sm btn-outline-secondary rounded-start-pill px-3" %>
                  <%= link_to admin_reviews_management_path(id: review.id), method: :delete, data: { confirm: "管理者権限で削除しますか？" }, class: "btn btn-sm btn-outline-danger rounded-end-pill px-3" do %>
                    <i class="fa-solid fa-trash"></i> 削除
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>