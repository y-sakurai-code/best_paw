<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold text-dark mb-1">
        <i class="fa-solid fa-comments text-secondary me-2"></i>レビュー管理
      </h2>
      <p class="text-secondary small mb-0">全投稿数: <span class="fw-bold text-dark"><%= @reviews.count %></span> 件</p>
    </div>
  </div>

  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-light">
          <tr>
            <th class="ps-4 py-3 text-secondary small fw-bold" style="width: 80px;">ID</th>
            <th class="py-3 text-secondary small fw-bold" style="width: 150px;">投稿者</th>
            <th class="py-3 text-secondary small fw-bold">内容</th>
            <th class="py-3 text-secondary small fw-bold" style="width: 180px;">評価</th>
            <th class="py-3 text-secondary small fw-bold" style="width: 150px;">投稿日</th>
            <th class="pe-4 py-3 text-end text-secondary small fw-bold" style="width: 180px;">操作</th>
          </tr>
        </thead>
        <tbody>
          <% @reviews.each do |review| %>
            <tr>
              <td class="ps-4 text-secondary small">
              <td>
                <div class="fw-bold text-dark small"><%= review.user.name %></div>
                <div class="text-muted" style="font-size: 0.75rem;"><%= review.user.email %></div>
              </td>
              <td>
                <div class="fw-bold text-dark mb-1"><%= review.title %></div>
                <div class="text-secondary small text-truncate" style="max-width: 450px;">
                  <%= review.body %>
                </div>
                <div class="mt-1">
                  <span class="badge bg-light text-secondary fw-normal border">
                    <i class="fa-regular fa-comment me-1"></i><%= review.review_comments.count %>
                  </span>
                </div>
              </td>
              <td>
                <%= render 'public/reviews/static_rate', review: review %>
              </td>
              <td class="text-secondary small">
                <%= review.created_at.strftime('%Y/%m/%d %H:%M') %>
              </td>
              <td class="pe-4 text-end">
                <div class="btn-group">
                  <%= link_to admin_reviews_management_path(review), class: "btn btn-sm btn-outline-secondary px-3 rounded-start-pill" do %>
                    詳細
                  <% end %>
                  <%= link_to admin_reviews_management_path(review), method: :delete, data: { confirm: "管理者権限でこのレビューを削除しますか？\nこの操作は取り消せません。" }, class: "btn btn-sm btn-outline-danger px-3 rounded-end-pill" do %>
                    <i class="fa-solid fa-trash-can"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    
    <% if @reviews.respond_to?(:total_pages) %>
      <div class="card-footer bg-white border-top-0 py-3">
        <div class="d-flex justify-content-center mt-4">
          <%= paginate @reviews %>
        </div>
      </div>
    <% end %>
  </div>
</div>