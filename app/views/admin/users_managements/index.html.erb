<div class="container py-4">
  <div class="d-flex justify-content-between align-items-end mb-4">
    <div>
      <h2 class="fw-bold text-dark mb-1">
        <i class="fa-solid fa-users-gear text-secondary me-2"></i>会員管理
      </h2>
      <p class="text-secondary small mb-0">全登録者数: <span class="fw-bold text-dark"><%= @users.total_count %></span> 名</p>
    </div>
  </div>

  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-light text-secondary">
          <tr>
            <th class="px-4 py-3" style="width: 80px;">ID</th>
            <th class="py-3">ユーザー</th>
            <th class="py-3">メールアドレス</th>
            <th class="py-3">登録日 / 退会日</th>
            <th class="py-3">ステータス</th>
            <th class="py-3 text-end px-4">操作</th>
          </tr>
        </thead>
        <tbody class="border-top-0">
          <% @users.each do |user| %>
            <tr class="<%= 'opacity-75 bg-light' if user.discarded? %>">
              <td class="px-4 text-secondary small">#<%= user.id %></td>
              <td>
                <div class="d-flex align-items-center">
                  <div class="bg-secondary-subtle rounded-circle me-2 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                    <i class="fa-solid fa-user text-secondary" style="font-size: 0.75rem;"></i>
                  </div>
                  <span class="fw-bold text-dark"><%= user.name %></span>
                </div>
              </td>
              <td class="text-secondary small">
                <%= user.email %>
              </td>
              <td class="text-secondary small">
                <div><%= user.created_at.strftime('%Y/%m/%d') %></div>
                <% if user.discarded_at.present? %>
                  <div class="text-danger"><i class="fa-solid fa-arrow-right-from-bracket me-1"></i><%= user.discarded_at.strftime('%Y/%m/%d') %></div>
                <% end %>
              </td>
              <td>
                <% if user.discarded? %>
                  <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-3">退会済</span>
                <% else %>
                  <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3">有効</span>
                <% end %>
              </td>
              <td class="text-end px-4">
                <%= link_to admin_users_management_path(user.id), class: "btn btn-sm btn-white border shadow-sm rounded-pill px-3 transition fw-bold" do %>
                  詳細表示
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    
    <% if @users.empty? %>
      <div class="text-center py-5">
        <i class="fa-solid fa-user-slash fa-3x text-light mb-3"></i>
        <p class="text-muted mb-0">該当するユーザーは見つかりませんでした。</p>
      </div>
    <% end %>
  </div>

  <div class="d-flex justify-content-center mt-4">
    <%= paginate @users %>
  </div>
</div>