<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark mb-0">
      <i class="fa-solid fa-users-gear text-secondary me-2"></i>会員管理
    </h2>
    <div class="text-secondary small">
      全登録者数: <span class="fw-bold text-dark"><%= @users.count %></span> 名
    </div>
  </div>

  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-light text-secondary">
          <tr>
            <th class="px-4 py-3" style="width: 80px;">ID</th>
            <th class="py-3">ユーザーネーム</th>
            <th class="py-3">メールアドレス</th>
            <th class="py-3">登録日</th>
            <th class="py-3">退会日</th>
            <th class="py-3">ステータス</th>
            <th class="py-3 text-end px-4">詳細</th>
          </tr>
        </thead>
        <tbody class="border-top-0">
          <% @users.each do |user| %>
            <tr>
              <td class="px-4 text-secondary small">
              <td>
                <div class="d-flex align-items-center">
                  <div class="bg-secondary-subtle rounded-circle p-2 me-2 d-inline-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
                    <i class="fa-solid fa-user text-secondary small"></i>
                  </div>
                  <span class="fw-bold text-dark"><%= user.name %></span>
                </div>
              </td>
              <td class="text-secondary small">
                <%= user.email %>
              </td>
              <td class="text-secondary small">
                <%= user.created_at.strftime('%Y/%m/%d') %>
              </td>
              </td>
              <td class="text-secondary small">
                <% if user.discarded_at.present? %>
                  <%= user.discarded_at.strftime('%Y/%m/%d') %>
                <% else %>
                  -
                <% end %>
              </td>
              <td class="text-secondary small">
                <% if user.discarded? %>
                  <span>退会済</span>
                <% else %>
                  <span>有効</span>
                <% end %>
              </td>
              <td class="text-end px-4">
                <%= link_to admin_users_management_path(user.id), class: "btn btn-sm btn-outline-dark rounded-pill px-3 transition" do %>
                  詳細
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    
    <% if @users.empty? %>
      <div class="text-center py-5">
        <p class="text-muted mb-0">登録されているユーザーはいません。</p>
      </div>
    <% end %>
  </div>
</div>

<style>
  .table-hover tbody tr:hover {
    background-color: rgba(0,0,0,0.02);
  }
  .transition {
    transition: all 0.2s ease;
  }
  .btn-outline-dark:hover {
    background-color: #343a40;
    color: #fff;
  }
</style>