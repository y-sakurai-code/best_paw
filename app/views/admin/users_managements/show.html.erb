<div class="container py-4">
  <div class="mb-4">
    <%= link_to admin_users_managements_path, class: "text-decoration-none text-secondary small" do %>
      <i class="fa-solid fa-arrow-left me-1"></i>会員一覧へ戻る
    <% end %>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-8">
      
      <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-dark py-3 px-4">
          <h5 class="text-white mb-0 fw-bold">
            <i class="fa-solid fa-id-card me-2 text-secondary"></i>会員詳細情報
          </h5>
        </div>
        
        <div class="card-body p-4 p-md-5">
          <div class="row mb-4">
            <div class="col-sm-4 text-secondary small fw-bold">ユーザーID</div>
            <div class="col-sm-8 text-dark"><%= @user.id %></div>
          </div>

          <div class="row mb-4">
            <div class="col-sm-4 text-secondary small fw-bold">ユーザーネーム</div>
            <div class="col-sm-8">
              <span class="fs-5 fw-bold text-dark"><%= @user.name %></span>
            </div>
          </div>

          <div class="row mb-4">
            <div class="col-sm-4 text-secondary small fw-bold">メールアドレス</div>
            <div class="col-sm-8">
              <span class="text-dark"><%= @user.email %></span>
            </div>
          </div>

          <div class="row mb-4">
            <div class="col-sm-4 text-secondary small fw-bold">登録日時</div>
            <div class="col-sm-8 text-secondary">
              <%= @user.created_at.strftime('%Y年 %m月 %d日 %H:%M') %>
            </div>
          </div>

          <% if @user.discarded? %>
            <div class="alert alert-warning">
              このユーザーは退会済みです（退会日時: <%= @user.discarded_at.strftime('%Y年 %m月 %d日 %H:%M') %>）
            </div>
          <% end %>

          <hr class="my-4 opacity-25">

            <div class="d-flex justify-content-between align-items-center mt-5">
              <% if @user.discarded? %>
                <div class="text-success small">
                  <i class="fa-solid fa-circle-info me-1"></i>このユーザーは現在退会済みです。復旧させる場合は右のボタンを押してください。
                </div>
    
                <%= link_to undiscard_admin_users_management_path(@user), method: :patch, data: { confirm: 'このユーザーを復旧させますか？' }, class: "btn btn-outline-success rounded-pill px-4 fw-bold" do %>
                  <i class="fa-solid fa-user-check me-1"></i>このユーザーを復旧
                <% end %>

              <% else %>
                <div class="text-muted small">
                  <i class="fa-solid fa-circle-info me-1"></i>このユーザーを退会させる場合は右のボタンを押してください。
                </div>
    
                <%= link_to soft_destroy_admin_users_management_path(@user), method: :patch, data: { confirm: '本当にこのユーザーを退会させますか？' }, class: "btn btn-outline-danger rounded-pill px-4 fw-bold" do %>
                  <i class="fa-solid fa-user-slash me-1"></i>このユーザーを退会
                <% end %>
              <% end %>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-5">
              <div class="text-muted small">
                <i class="fa-solid fa-circle-info me-1"></i>このユーザーを完全に削除する場合は右のボタンを押してください。
              </div>
            
              <%= link_to admin_users_management_path(@user), method: :delete, data: { confirm: '本当にこのユーザーを削除しますか？' }, class: "btn btn-outline-danger rounded-pill px-4 fw-bold" do %>
                <i class="fa-solid fa-user-slash me-1"></i>このユーザーを削除
              <% end %>
            </div>
        </div>
      </div>

    </div>
  </div>
</div>