<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <title>BestPaw | 管理者モード</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script src="https://kit.fontawesome.com/d1b2e80093.js" crossorigin="anonymous"></script>
    <%= stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>

    <style>
      body {
        background-color: #f4f7f9; /* 管理画面らしい少し落ち着いた背景色 */
        font-family: 'Noto Sans JP', sans-serif;
      }
      .admin-navbar {
        background-color: #343a40; /* ダークな配色で「管理モード」を強調 */
      }
      .admin-brand {
        font-weight: bold;
        color: #ffffff !important;
      }
      .nav-link-admin {
        color: rgba(255,255,255,0.8) !important;
      }
      .nav-link-admin:hover {
        color: #ffffff !important;
      }
    </style>
  </head>

  <body>
    <header class="admin-navbar shadow-sm mb-4">
      <nav class="navbar navbar-expand-lg">
        <div class="container">
          <%= link_to admin_dashboards_path, class: "navbar-brand admin-brand" do %>
            <i class="fa-solid fa-unlock-keyhole me-2 text-warning"></i>BestPaw Admin
          <% end %>

          <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav">
            <i class="fa-solid fa-bars text-white"></i>
          </button>

          <div class="collapse navbar-collapse" id="adminNav">
            <ul class="navbar-nav ms-auto align-items-center">
              <% if admin_signed_in? %>
                <%# 必要に応じてメニューを追加 %>
                <li class="nav-item">
                  <%= link_to '会員管理', admin_dashboards_path, class: "nav-link nav-link-admin px-3" %>
                </li>
                <li class="nav-item">
                  <%= link_to 'レビュー管理', admin_reviews_managements_index_path, class: "nav-link nav-link-admin px-3" %>
                </li>
                <li class="nav-item">
                  <%= link_to '商品管理', admin_items_path, class: "nav-link nav-link-admin px-3" %>
                </li>
                <li class="nav-item">
                  <%= link_to 'ジャンル管理', admin_genres_path, class: "nav-link nav-link-admin px-3" %>
                </li>
                <li class="nav-item ms-lg-3">
                  <%= link_to destroy_admin_session_path, method: :delete, class: "btn btn-outline-light btn-sm rounded-pill px-3" do %>
                    <i class="fa-solid fa-right-from-bracket me-1"></i>ログアウト
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      </nav>
    </header>

    <%# --- メインコンテンツ --- %>
    <main class="container">
      <%# 通知メッセージ（Flash）の表示エリア %>
      <% flash.each do |key, value| %>
        <div class="alert alert-<%= key == 'notice' ? 'success' : 'danger' %> alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
          <%= value %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="text-center py-4 mt-5 text-secondary">
      <small>&copy; 2026 Best Paw Admin Panel</small>
    </footer>
  </body>
</html>