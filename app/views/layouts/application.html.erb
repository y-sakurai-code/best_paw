<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <title>BestPaw</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
    <script src="https://kit.fontawesome.com/d1b2e80093.js" crossorigin="anonymous"></script>
    <%= stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <header class="py-2 border-bottom shadow-sm bg-white">
      <nav class="navbar navbar-expand-lg">
        <div class="container">
          <% if user_signed_in? %>
            <%= link_to reviews_path, class: "navbar-brand fw-bold text-warning fs-3" do %>
              Best Paw
            <% end %>
          <% else %>
            <%= link_to root_path, class: "navbar-brand fw-bold text-warning fs-3" do %>
              Best Paw
            <% end %>
          <% end %>

          <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start w-100">
            <ul class="nav col-12 col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0 align-items-center">
              <% if user_signed_in? %>
                <li><%= link_to "About", about_path, class: 'nav-link px-3 text-secondary fw-semibold' %></li>
                <li><%= link_to 'マイページ', users_mypage_path, class: 'nav-link px-3 text-secondary fw-semibold' %></li>
                <li><%= link_to 'レビュー投稿', new_review_path, class: 'nav-link px-3 text-secondary fw-semibold' %></li>
                <li><%= link_to "ログアウト", destroy_user_session_path, method: :delete, class: 'nav-link px-3 text-danger small' %></li>
              <% else %>
                <li><%= link_to "About", about_path, class: 'nav-link px-3 text-secondary fw-semibold' %></li>
                <li><%= link_to "ログイン", new_user_session_path, class: 'nav-link px-3 text-secondary fw-semibold' %></li>
                <li><%= link_to "新規登録", new_user_registration_path, class: 'btn btn-warning btn-sm ms-2 rounded-pill px-3 shadow-sm' %></li>
              <% end %>
            </ul>

            <% if user_signed_in? %>
              <%= form_with url: search_path, local: true, method: :get, class: "col-12 col-lg-auto mb-3 mb-lg-0 d-flex align-items-center bg-light p-1 rounded-pill" do |f| %>
                <%= f.text_field :word, class: "form-control form-control-sm border-0 bg-transparent ps-3", placeholder: "検索..." %>
                <%= f.select :range, options_for_select([['Dog'], ['Review']]), {}, class: "form-select form-select-sm border-0 bg-transparent text-muted" %>
                <%= f.submit "検索", class: "btn btn-sm btn-warning rounded-pill px-3 fw-bold" %>
              <% end %>

              <div class="dropdown ms-3">
                <a href="#" class="nav-link position-relative text-secondary" id="notificationDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <i class="fa-regular fa-bell fs-5"></i>
                  <% if current_user.passive_notifications.where(checked: false).any? %>
                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                  <% end %>
                </a>

                <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-0 mt-2" aria-labelledby="notificationDropdown" style="width: 280px; max-height: 400px; overflow-y: auto;">
                  <li class="p-2 border-bottom bg-light">
                    <span class="small fw-bold text-secondary">通知</span>
                  </li>
                  
                  <% if current_user.passive_notifications.any? %>
                    <%# 最新の5件を表示 %>
                    <% current_user.passive_notifications.order(created_at: :desc).limit(5).each do |notification| %>
                      <li>
                        <%= link_to review_path(notification.subject_id), class: "dropdown-item py-2 border-bottom" do %>
                          <div class="d-flex align-items-center">
                            <div class="small">
                              <% case notification.subject_type %>
                              <% when 'Review' %>
                                <strong><%= notification.visitor.name %></strong> さんがあなたのレビューにいいねしました
                              <% when 'ReviewComment' %>
                                <% if notification.action == 'comment' %>
                                  <strong><%= notification.visitor.name %></strong> さんがあなたのレビューにコメントしました
                                <% elsif notification.action == 'favorite_comment' %>
                                  <strong><%= notification.visitor.name %></strong> さんがあなたのコメントにいいねしました
                                <% end %>
                              <% end %>
                              <div class="text-muted" style="font-size: 0.7rem;"><%= time_ago_in_words(notification.created_at) %>前</div>
                            </div>
                          </div>
                        <% end %>
                      </li>
                    <% end %>
                    <li>
                      <%= link_to "すべての通知を見る", notifications_path, class: "dropdown-item text-center small text-warning fw-bold py-2" %>
                    </li>
                  <% else %>
                    <li class="p-3 text-center text-muted small">通知はありません</li>
                  <% end %>
                </ul>
              </div>
            <% end %>

          </div>
        </div>
      </nav>
    </header>
    <% flash.each do |message_type, message| %>
      <div class="alert alert-<%= message_type == 'notice' ? 'success' : 'danger' %>">
        <%= message %>
      </div>
    <% end %>
    <%= yield %>
      <footer class="py-5 mt-5" style="background-color: #f8f9fa; border-top: 5px solid #ffc107;">
        <div class="container">
          <div class="row justify-content-center">
            <div class="col-md-4 mb-4 mb-md-0 text-center text-center">
              <div class="mb-3">
                <h3 class="fw-bold text-warning d-inline-block align-middle ms-2">Best Paw</h3>
              </div>
              <p class="text-secondary small">
                大切な家族である愛犬との毎日を、<br>
                もっと楽しく、もっと幸せを共有するレビューサイト。
              </p>
            </div>
          </div>
        </div>

        <hr class="my-4 text-secondary opacity-25">

        <div class="text-center">
          <p class="text-secondary small mb-0">&copy; 2026 Best Paw Inc. All Rights Reserved.</p>
        </div>
      </footer>

    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  </body>
</html>
