<%= form_with model: dog, local: true do |f| %>

  <% if dog.errors.any? %>
    <div class="alert alert-danger rounded-4">
      <ul class="mb-0">
        <% dog.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :dog_image, "愛犬の写真", class: "form-label fw-bold" %>
    <div class="p-3 border rounded-4 bg-light">
      <% if dog.dog_image.attached? %>
        <div class="d-flex align-items-center mb-3">
          <div class="me-3">
            <p class="small text-secondary mb-1">現在の写真</p>
            <%= image_tag dog.dog_image, class: "rounded shadow-sm", style: "width: 80px; height: 80px; object-fit: cover;" %>
          </div>
          <div class="form-check border border-danger-subtle bg-white p-2 px-3 rounded-pill shadow-sm">
            <%= f.check_box :image_del, class: "form-check-input ms-0 me-2", id: "imageDeleteCheck" %>
            <%= f.label :image_del, for: "imageDeleteCheck", class: "form-check-label text-danger fw-bold small cursor-pointer" do %>
              <i class="fa-solid fa-trash-can me-1"></i> 画像を削除
            <% end %>
          </div>
        </div>
      <% end %>
      
      <%= f.file_field :dog_image, class: "form-control form-control-sm bg-white" %>
      <div class="form-text mt-1" style="font-size: 0.7rem;">※新しい写真を選ぶと自動的に上書きされます。</div>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-md-6 mb-3">
      <%= f.label :name, "名前", class: "form-label fw-bold" %>
      <%= f.text_field :name, class: "form-control rounded-pill", placeholder: "例：ポチ" %>
    </div>

    <div class="col-md-6 mb-3">
      <%= f.label :breed, "犬種", class: "form-label fw-bold" %>
      <%= f.text_field :breed, class: "form-control rounded-pill", placeholder: "例：トイプードル" %>
    </div>

    <div class="col-md-6 mb-3">
      <%= f.label :birthday, "誕生日", class: "form-label fw-bold" %>
      <%= f.date_field :birthday, class: "form-control rounded-pill" %>
    </div>

    <div class="col-md-6 mb-4">
      <%= f.label :size, "サイズ", class: "form-label fw-bold" %>
      <%= f.select :size, Dog.sizes.keys.to_a, { include_blank: "選択してください" }, { class: "form-select rounded-pill" } %>
    </div>

    <div class="col-md-6 mb-4">
      <label class="form-label fw-bold">性別</label>
      <div class="d-flex gap-5">
        <% Dog.genders.keys.each do |key| %>
        <% next if key == "unknown" %>
          <div class="form-check">
            <%= f.label :gender, value: key, class: "form-check-label" do %>
              <%= f.radio_button :gender, key, class: "form-check-input" %>
              <%= key == "male" ? "男の子" : "女の子" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

  </div>

  <div class="actions mt-2">
    <%= f.submit yield(:button_text), class: "btn btn-warning w-100 rounded-pill fw-bold py-2 shadow-sm" %>
  </div>

<% end %>