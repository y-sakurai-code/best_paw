<% provide(:button_text, '新しく登録する') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      
      <div class="d-flex align-items-center mb-4">
        <i class="fa-solid fa-paw text-warning fs-3 me-2"></i>
        <h3 class="fw-bold mb-0">新しい家族の登録</h3>
      </div>

      <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <p class="text-secondary small mb-4">
          愛犬のプロフィールを入力してください。写真は後からでも変更できます。
        </p>
        
        <%= render 'dog_form', dog: @dog %>
        
        <div class="text-center mt-4">
          <%= link_to users_mypage_path, class: "btn btn-link text-secondary text-decoration-none" do %>
            <i class="fa-solid fa-angle-left me-1"></i>マイページに戻る
          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>