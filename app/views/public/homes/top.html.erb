<div class="container py-5">
  <div class="row align-items-center g-5 py-md-5">
    
    <div class="col-lg-6 text-center text-lg-start">
      <h1 class="display-4 fw-bold lh-1 mb-4 text-warning">
        <i class="fa-solid fa-paw me-2"></i>Best Paw
      </h1>

      <%# ロゴとサイト説明文 %>
      <p class="lead fw-normal text-secondary mb-5">
        Best Pawは、犬を愛する人たちのための、<br class="d-none d-md-block">
        優しくて温かいレビュー共有サイトです。
      </p>

      <%# 新規登録・ログインのボタン %>
      <div class="d-grid gap-3 d-md-flex justify-content-md-start mb-3">
        <%= link_to "今すぐ始める（新規登録）", new_user_registration_path, class: "btn btn-warning btn-lg px-4 rounded-pill fw-bold shadow-sm" %>
        <%= link_to "ログイン", new_user_session_path, class: "btn btn-outline-secondary btn-lg px-4 rounded-pill" %>
      </div>

      <%# ゲストログイン用ボタン %>
      <div class="d-grid d-md-flex justify-content-md-start">
        <%= link_to guest_sign_in_path, method: :post, class: 'btn btn-outline-warning btn-sm px-4 rounded-pill text-secondary border-secondary-subtle' do %>
          <strong>ゲストログインで体験する</strong>
        <% end %>
      </div>
    </div>

    <%# 肉球アイコン %>
    <div class="col-10 col-sm-8 col-lg-6 mx-auto">
      <div class="ratio ratio-1x1 bg-warning-subtle rounded-circle shadow-sm d-flex align-items-center justify-content-center">
        <div class="d-flex align-items-center justify-content-center">
          <i class="fa-solid fa-paw fa-10x text-white opacity-75"></i>
        </div>
      </div>
    </div>

  </div>
</div>