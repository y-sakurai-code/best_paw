<%# エラーがあった場合の表示 %>
<% if review.errors.any? %>
  <div class="alert alert-danger border-0 shadow-sm rounded-4 p-4 mb-4">
    <div class="d-flex align-items-center mb-2">
      <i class="fa-solid fa-triangle-exclamation fs-4 me-2"></i>
      <h5 class="fw-bold mb-0"><%= review.errors.count %>件のエラーが発生しました</h5>
    </div>
    <ul class="mb-0 small">
      <% review.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%# ここから入力（編集）フォーム %>
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
  <%= form_with model: review, local: true do |f| %>
    <div class="bg-warning-subtle p-3 p-md-4 border-bottom border-white shadow-inner">
      <div class="d-flex align-items-center mb-3 px-2">
        <i class="fa-solid fa-paw text-warning me-2"></i>
        <span class="text-warning-emphasis fw-bold small" style="letter-spacing: 0.1rem;">SELECT TARGET FAMILY</span>
      </div>
      
      <%#  飼っているどの犬にグッズ（アイテム）を与えたかチェックボックス%>
      <div class="d-flex flex-wrap gap-3 px-2">
        <% current_user.dogs.where(is_archived: false).each do |dog| %>
          <div class="dog-select-item">
            <%= check_box_tag "review[dog_ids][]", dog.id, review.dog_ids.include?(dog.id), id: "dog_#{dog.id}", class: "btn-check", autocomplete: "off" %>
            <label class="dog-card-label" for="dog_<%= dog.id %>">
              <div class="dog-image-wrapper">
                <% if dog.dog_image.attached? %>
                  <%= image_tag dog.dog_image, class: "dog-avatar" %>
                <% else %>
                  <div class="dog-avatar-empty">
                    <i class="fa-solid fa-dog"></i>
                  </div>
                <% end %>
                <div class="check-badge">
                  <i class="fa-solid fa-check"></i>
                </div>
              </div>
              <div class="dog-name"><%= dog.name %></div>
            </label>
          </div>
        <% end %>
      </div>
    </div>

    <div class="card-body p-4 p-md-5">
      <div class="row g-3 mb-4">
        <div class="col-md-8">

          <%= f.label :item_name, class: "form-label mb-2" do %>
            <span class="badge bg-warning text-dark fw-normal px-3 py-2">商品名</span>
          <% end %>
          <div class="input-group">
            <span class="input-group-text border-0 bg-light text-warning rounded-start-3">
              <i class="fa-solid fa-cart-shopping"></i>
            </span>
            <%= f.text_field :item_name, class: "form-control border-0 bg-light rounded-end-3 shadow-sm", placeholder: "愛犬がお気に入りの商品名を入力してください" %>
          </div>
        </div>

        <div class="col-md-4">
          <%= f.label :genre_id, class: "form-label mb-2" do %>
            <span class="badge border border-warning text-warning fw-normal px-3 py-2">ジャンル</span>
          <% end %>
          <%= f.collection_select :genre_id, Genre.all, :id, :name, { include_blank: "選択してください" }, { class: "form-select border-0 bg-light rounded-3 shadow-sm text-secondary", style: "height: 46px;" } %>
        </div>
      </div>

      <div class="mb-4">
        <%= f.label :title, class: "form-label mb-2" do %>
          <span class="badge bg-warning text-dark fw-normal px-3 py-2">レビュータイトル</span>
        <% end %>
        <%= f.text_field :title, class: "form-control form-control-lg border-0 bg-light rounded-3 shadow-sm", placeholder: "例：最高のおやつ見つけました！" %>
      </div>

      <div class="row mb-4">
        <div class="col-md-6">
          <%= f.label :category, class: "form-label mb-2" do %>
            <span class="badge border border-warning text-warning fw-normal px-3 py-2">タグ</span>
          <% end %>
          <div class="input-group">
            <span class="input-group-text border-0 bg-light rounded-start-3 text-warning">
              <i class="fa-solid fa-tag"></i>
            </span>
            <%= f.text_field :category, class: "form-control border-0 bg-light rounded-end-3 shadow-sm", placeholder: "例：無添加、シニア犬など" %>
          </div>
        </div>
      </div>

      <div class="mb-4">
        <%= f.label :body, class: "form-label mb-2" do %>
          <span class="badge bg-light text-secondary border fw-normal px-3 py-2">レビュー本文</span>
        <% end %>
        <%= f.text_area :body, class: "form-control border-0 bg-light rounded-3 shadow-sm", rows: 6, placeholder: "使い心地や愛犬の反応を詳しく教えてね" %>
      </div>

      <%# 満足度（Ratyを使った評価入力） %>
      <div class="bg-light p-3 px-4 rounded-4 shadow-sm mb-5 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
          <span class="fw-bold text-secondary me-4 small">満足度：</span>
          <div id="post_raty"></div>
          <%= f.hidden_field :star, id: :review_star %>
        </div>
        <div class="small text-secondary fw-bold d-none d-sm-block">星をタップして評価</div>
      </div>

      <div class="row justify-content-center pt-3">
        <div class="col-md-6 text-center">
          <div class="d-grid gap-3">
            <%= f.submit review.new_record? ? 'レビューを投稿する' : '内容を更新する', class: "btn btn-warning btn-lg rounded-pill fw-bold shadow-sm py-3 px-5" %>
            <%= link_to 'キャンセルして戻る', reviews_path, class: "btn btn-link text-secondary text-decoration-none small" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<%# Ratyを使った星評価入力用 %>
<script>
  $(document).on('turbolinks:load', function() {
    let elem = document.querySelector('#post_raty');
    if (elem == null) return;

    elem.innerHTML = "";
    let opt = {
      starOn: "<%= asset_path('star-on.png') %>",
      starOff: "<%= asset_path('star-off.png') %>",
      starHalf: "<%= asset_path('star-half.png') %>",
      scoreName: 'review[star]',
      half: true,
      score: <%= review.star.presence || 0 %>,

      click: function(score, e) {
        $("#review_star").val(score);
      }
    };

    if (typeof window.raty === 'function') {
      window.raty(elem, opt);
    }
  });
</script>

<%# グッズ（アイテム）を与えた犬を選択した際にかわかりやすくする表示用CSS %>
<style>
  .dog-card-label {
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: center;
    width: 80px;
  }

  .dog-image-wrapper {
    position: relative;
    width: 65px;
    height: 65px;
    margin: 0 auto 8px;
  }

  .dog-avatar, .dog-avatar-empty {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid white;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    transition: all 0.3s ease;
    background-color: #f8f9fa;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .check-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    background-color: #ffc107;
    color: white;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    border: 2px solid white;
    transform: scale(0);
    transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .btn-check:checked + .dog-card-label .dog-avatar {
    border-color: #ffc107;
    transform: translateY(-5px);
    box-shadow: 0 8px 15px rgba(255, 193, 7, 0.3);
  }

  .btn-check:checked + .dog-card-label .check-badge {
    transform: scale(1);
  }

  .dog-name {
    font-size: 0.85rem;
    font-weight: bold;
    color: #6c757d;
    transition: color 0.3s ease;
  }

  .btn-check:checked + .dog-card-label .dog-name {
    color: #ff9800;
  }
</style>