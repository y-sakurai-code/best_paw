<% if review.errors.any? %>
  <div class="alert alert-danger border-0 shadow-sm rounded-4 p-4 mb-4">
    <div class="d-flex align-items-center mb-2">
      <i class="fa-solid fa-triangle-exclamation fs-4 me-2"></i>
      <h5 class="fw-bold mb-0"><%= review.errors.count %>件のエラーが発生しました</h5>
    </div>
    <ul class="mb-0 small">
      <% review.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
  <%= form_with model: review, local: true do |f| %>
    <div class="bg-warning-subtle p-3 p-md-4 border-bottom border-white shadow-inner">
      <div class="d-flex align-items-center mb-3 px-2">
        <i class="fa-solid fa-paw text-warning me-2"></i>
        <span class="text-warning-emphasis fw-bold small" style="letter-spacing: 0.1rem;">SELECT TARGET FAMILY</span>
      </div>
      
      <div class="d-flex flex-wrap gap-3 px-2">
        <% current_user.dogs.where(is_archived: false).each do |dog| %>
          <div class="dog-select-item">
            <%= check_box_tag "review[dog_ids][]", dog.id, review.dog_ids.include?(dog.id), id: "dog_#{dog.id}", class: "btn-check", autocomplete: "off" %>
            <label class="btn btn-outline-warning p-1 pe-3 rounded-pill d-flex align-items-center bg-white shadow-sm" for="dog_<%= dog.id %>" style="border-width: 2px;">
              <% if dog.dog_image.attached? %>
                <%= image_tag dog.dog_image, class: "rounded-circle border border-2 border-white", style: "width: 45px; height: 45px; object-fit: cover;" %>
              <% else %>
                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center border border-2 border-white" style="width: 45px; height: 45px;">
                  <i class="fa-solid fa-dog text-secondary"></i>
                </div>
              <% end %>
              <div class="ms-2 fw-bold"><%= dog.name %></div>
            </label>
          </div>
        <% end %>
      </div>
    </div>

    <div class="card-body p-4 p-md-5">
      <div class="mb-4">
        <%= f.label :title, class: "form-label mb-2" do %>
          <span class="badge bg-warning text-dark fw-normal px-3 py-2">レビュータイトル</span>
        <% end %>
        <%= f.text_field :title, class: "form-control form-control-lg border-0 bg-light rounded-3 shadow-sm", placeholder: "例：最高のおやつ見つけました！" %>
      </div>

      <div class="row mb-4">
        <div class="col-md-5">
          <%= f.label :category, class: "form-label mb-2" do %>
            <span class="badge border border-warning text-warning fw-normal px-3 py-2">タグ</span>
          <% end %>
          <div class="input-group">
            <span class="input-group-text border-0 bg-light rounded-start-3 text-warning">
              <i class="fa-solid fa-tag"></i>
            </span>
            <%= f.text_field :category, class: "form-control border-0 bg-light rounded-end-3 shadow-sm", placeholder: "例：おもちゃ, フード" %>
          </div>
        </div>
      </div>

      <div class="mb-4">
        <%= f.label :body, class: "form-label mb-2" do %>
          <span class="badge bg-light text-secondary border fw-normal px-3 py-2">レビュー本文</span>
        <% end %>
        <%= f.text_area :body, class: "form-control border-0 bg-light rounded-3 shadow-sm", rows: 6, placeholder: "使い心地や愛犬の反応を詳しく教えてね" %>
      </div>

      <div class="bg-light p-3 px-4 rounded-4 shadow-sm mb-5 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
          <span class="fw-bold text-secondary me-4 small">満足度：</span>
          <div id="post_raty"></div>
          <%= f.hidden_field :star, id: :review_star %>
        </div>
        <div class="small text-secondary fw-bold d-none d-sm-block">星をタップして評価</div>
      </div>

      <div class="row justify-content-center pt-3">
        <div class="col-md-6 text-center">
          <div class="d-grid gap-3">
            <%= f.submit review.new_record? ? 'レビューを投稿する' : '内容を更新する', class: "btn btn-warning btn-lg rounded-pill fw-bold shadow-sm py-3 px-5" %>
            <%= link_to 'キャンセルして戻る', reviews_path, class: "btn btn-link text-secondary text-decoration-none small" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<script>
  $(document).on('turbolinks:load', function() {
    let elem = document.querySelector('#post_raty');
    if (elem == null) return;

    elem.innerHTML = "";
    let opt = {
      starOn: "<%= asset_path('star-on.png') %>",
      starOff: "<%= asset_path('star-off.png') %>",
      starHalf: "<%= asset_path('star-half.png') %>",
      scoreName: 'review[star]',
      half: true,
      score: <%= review.star.presence || 0 %>,

      click: function(score, e) {
        $("#review_star").val(score);
      }
    };

    if (typeof window.raty === 'function') {
      window.raty(elem, opt);
    }
  });
</script>