<div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
  <div class="row g-0">

    <div class="col-md-3 bg-warning-subtle d-flex flex-column align-items-center justify-content-center py-4 position-relative">
      <i class="fa-solid fa-paw fa-3x text-white opacity-75"></i>
      <span class="badge rounded-pill bg-warning text-dark mt-2 shadow-sm">
        <%= review.category %>
      </span>
    </div>


    <div class="col-md-9">
      <div class="card-body p-4 d-flex flex-column h-100">
        <div class="d-flex justify-content-between align-items-start mb-2 gap-2">
          <h5 class="fw-bold mb-0">
            <%= link_to review.title, review_path(review.id), class: "text-dark text-decoration-none" %>
          </h5>
          <div class="text-end flex-shrink-0">
            <%= render 'public/reviews/static_rate', review: review %>
          </div>
        </div>

        <p class="card-text text-secondary small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; line-height: 1.5; height: 3em;">
          <%= review.body %>
        </p>

        <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
          <div class="small text-muted">
            <i class="fa-solid fa-user-circle me-1"></i><%= review.user.name %>
            <span class="ms-2 small opacity-75"><%= review.created_at.strftime('%Y/%m/%d') %></span>
          </div>

          <div class="btn-group shadow-sm">
            <%= link_to review_path(review.id), class: "btn btn-sm btn-outline-warning rounded-start-pill px-3", title: "詳細" do %>
              <i class="fa-solid fa-eye"></i>
            <% end %>

            <% if review.user == current_user %>
              <%= link_to edit_review_path(review.id), class: "btn btn-sm btn-outline-warning px-3", title: "編集" do %>
                <i class="fa-solid fa-pen"></i>
              <% end %>
              <%= link_to review_path(review.id), method: :delete, data: { confirm: "削除してもよろしいですか？" }, class: "btn btn-sm btn-outline-danger rounded-end-pill px-3", title: "削除" do %>
                <i class="fa-solid fa-trash"></i>
              <% end %>
            <% else %>
              <style>.btn-group > .btn:first-child:last-child { border-radius: 50rem !important; }</style>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>