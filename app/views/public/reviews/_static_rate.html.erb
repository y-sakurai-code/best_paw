<div class="d-flex align-items-center">
  <div id="star-show-<%= review.id %>"></div>
</div>

<script>
  $(document).on('turbolinks:load turbo:load', function() {
    let elem = document.querySelector('#star-show-<%= review.id %>');
    if (elem == null) return;

    elem.innerHTML = "";
    let opt = {
      starType: 'i',
      starOn: 'fa-solid fa-star text-warning fs-3',
      starOff: 'fa-regular fa-star text-secondary fs-3',
      starHalf: 'fa-solid fa-star-half-stroke text-warning fs-3',
      score: "<%= review.star || 0 %>",
      readOnly: true,
      half: true,
    };
    raty(elem, opt);
  });
</script>