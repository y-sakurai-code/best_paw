<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
        
        <div class="text-center mb-4">
          <div class="bg-warning-subtle rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
            <i class="fa-solid fa-pen-nib fa-2x text-warning"></i>
          </div>
          <h2 class="fw-bold">レビューを編集</h2>
          <p class="text-secondary small">内容を修正して、最新の情報を共有しましょう</p>
        </div>

        <% if @review.errors.any? %>
          <div class="alert alert-danger border-0 rounded-4 shadow-sm mb-4">
            <div class="fw-bold mb-1 text-danger"><%= @review.errors.count %>件のエラーがあります</div>
            <ul class="mb-0 small text-danger">
              <% @review.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with model: @review, local: true do |f| %>
          <div class="mb-4">
            <%= f.label :title, "レビュータイトル", class: "form-label fw-bold" %>
            <%= f.text_field :title, class: "form-control form-control-lg bg-light border-0 rounded-3", placeholder: "タイトルの修正" %>
          </div>

          <div class="mb-4">
            <%= f.label :body, "レビュー本文", class: "form-label fw-bold" %>
            <%= f.text_area :body, class: "form-control bg-light border-0 rounded-3", rows: 6, placeholder: "本文の修正" %>
          </div>

          <div class="d-grid gap-2 mt-4">
            <%= f.submit '変更を保存する', class: "btn btn-warning btn-lg rounded-pill fw-bold shadow-sm py-3" %>
          </div>
        <% end %>

        <hr class="my-5 opacity-25">

        <div class="d-flex flex-wrap justify-content-between align-items-center">
          <div>
            <%= link_to review_path(@review.id), class: "btn btn-outline-secondary rounded-pill px-3 me-2 small" do %>
              <i class="fa-solid fa-eye me-1"></i>表示を確認
            <% end %>
            <%= link_to reviews_path, class: "btn btn-link text-secondary text-decoration-none small" do %>
              一覧へ戻る
            <% end %>
          </div>

          <%= link_to review_path(@review.id), method: :delete, data: { confirm: "このレビューを完全に削除しますか？" }, class: "btn btn-outline-danger btn-sm rounded-pill px-3" do %>
            <i class="fa-solid fa-trash-can me-1"></i>削除する
          <% end %>
        </div>

      </div>
    </div>
  </div>
</div>