<div class="bg-light py-5">
  <div class="container">
    
    <div class="text-center mb-5">
      <div class="swiper mySwiper">
        <div class="swiper-wrapper">
          <% if @dog_images.any? %>
            <% @dog_images.each do |image| %>
              <div class="swiper-slide">
                <%= image_tag image['url'], alt: "わんこ画像" %>
                <div class="image-overlay">
                  <div class="overlay-content">
                    <span class="badge bg-warning text-dark mb-2">今日のわんこ</span>
                    <p class="attribution">Powered by The Dog API</p>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
        <div class="swiper-pagination"></div>
        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>
      </div>
    </div>

    <div class="row justify-content-center mb-5">
      <div class="col-md-7 col-lg-6">
        <%= form_with url: reviews_path, method: :get, local: true, class: "shadow-sm rounded-pill overflow-hidden d-flex bg-white border border-2 border-warning-subtle" do |f| %>
          <div class="d-flex align-items-center ps-3 text-warning">
            <i class="fa-solid fa-tag"></i>
          </div>
          <%= f.text_field :tag_name, value: @search_word, placeholder: "気になるタグ（おもちゃ、フードなど）で検索", class: "form-control border-0 py-3 shadow-none bg-transparent", style: "font-size: 0.95rem;" %>
          <%= f.submit "検索", class: "btn btn-warning px-4 fw-bold text-dark", style: "letter-spacing: 0.1rem;" %>
        <% end %>
      </div>
    </div>


    <div class="row justify-content-center">
      <div class="col-lg-10">
        
        <div class="d-flex align-items-center justify-content-between mb-4 px-2">
          <div class="d-flex align-items-center">
            <i class="fa-solid fa-list-ul text-warning me-2"></i>
            <h4 class="fw-bold mb-0" style="font-size: 1.25rem;">
              <% if params[:keyword].present? %>
                「<span class="text-warning master-font"><%= params[:keyword] %></span>」の検索結果
              <% else %>
                新着レビュー
              <% end %>
            </h4>
          </div>
          <div class="text-secondary small fw-bold bg-white px-3 py-1 rounded-pill shadow-sm">
            全 <%= @reviews.total_count %> 件
          </div>
        </div>

        <% if @reviews.any? %>
          <div class="row row-cols-1 row-cols-md-2 g-4">
            <% @reviews.each do |review| %>
              <div class="col">
                <%= render 'public/reviews/review_card', review: review %>
              </div>
            <% end %>
          </div>
          <div class="d-flex justify-content-center mt-5">
            <%= paginate @reviews %>
          </div>
        <% else %>
          <div class="text-center py-5 bg-white rounded-4 shadow-sm mt-2 border border-2 border-dashed border-warning-subtle">
            <div class="mb-3 opacity-25">
              <i class="fa-solid fa-magnifying-glass fa-4x text-warning"></i>
            </div>
            <p class="text-dark fw-bold mb-1">一致するレビューが見つかりませんでした</p>
            <p class="text-secondary small mb-4">別のキーワードで試してみるか、全件表示に戻ってください。</p>
            <%= link_to reviews_path, class: "btn btn-outline-warning rounded-pill px-4 fw-bold" do %>
              <i class="fa-solid fa-rotate-left me-1"></i>全件表示に戻る
            <% end %>
          </div>
        <% end %>

      </div>
    </div>

  </div>
</div>


<script>
  function initPlugins() {
    if (document.querySelector('.mySwiper')) {
      new Swiper('.mySwiper', {
        loop: true,
        autoplay: { delay: 3000, disableOnInteraction: false },
        pagination: { el: '.swiper-pagination', clickable: true },
        navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' },
      });
    }
  }

  document.addEventListener('turbolinks:load', initPlugins);
</script>

<style>
  .mySwiper {
    width: 90%;
    height: 550px;
    border-radius: 15px;
    overflow: hidden;
  }

  .swiper-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .swiper-button-next, .swiper-button-prev {
    color: #ffc107;
  }
  .swiper-pagination-bullet-active {
    background: #ffc107;
  }

  .swiper-slide {
    position: relative;
    overflow: hidden;
  }

  .image-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 50%);
    display: flex;
    align-items: flex-end;
    padding: 20px;
    box-sizing: border-box;
  }

  .overlay-content {
    text-align: left;
    color: white;
  }

  .badge {
    font-size: 0.9rem;
    font-weight: bold;
    padding: 5px 12px;
  }

  .attribution {
    font-size: 0.7rem;
    margin: 0;
    opacity: 0.8;
  }

</style>

<style>
  .pagination .page-item.active .page-link {
    background-color: #ffc107;
    border-color: #ffc107;
    color: #fff;
  }
  .pagination .page-item .page-link {
    color: #856404;
  }
</style>