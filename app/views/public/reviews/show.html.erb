<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-9">

      <div class="text-center mb-4">
        <div class="bg-warning-subtle rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
          <i class="fa-solid fa-file-lines fa-2x text-warning"></i>
        </div>
        <h2 class="fw-bold">レビュー詳細</h2>
        <p class="text-secondary small">愛犬との素敵な思い出をチェックしましょう</p>
      </div>

      <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
        
        <div class="bg-warning-subtle p-3 border-bottom border-white">
          <div class="d-flex align-items-center mb-2 px-2">
            <i class="fa-solid fa-paw text-warning me-2"></i>
            <span class="text-warning-emphasis fw-bold small" style="letter-spacing: 0.1rem;">REVIEW TARGET DOGS</span>
          </div>
          
          <div class="d-flex flex-wrap gap-3 px-2">
            <% if @review.dogs.any? %>
              <% @review.dogs.each do |dog| %>
                <div class="d-flex align-items-center bg-white rounded-pill pe-3 py-1 shadow-sm border border-light">
                  <% if dog.dog_image.attached? %>
                    <%= image_tag dog.dog_image, class: "rounded-circle border border-2 border-white", style: "width: 75px; height: 75px; object-fit: cover;" %>
                  <% else %>
                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center border border-2 border-white" style="width: 75px; height: 75px;">
                      <i class="fa-solid fa-dog text-secondary" style="font-size: 0.8rem;"></i>
                    </div>
                  <% end %>
                  
                  <div class="ms-2">
                    <div class="fw-bold text-dark" style="font-size: 0.75rem;">
                      <%= dog.name %> 
                      <% if dog.male? %>
                        <i class="fa-solid fa-mars text-primary" style="font-size: 0.6rem;"></i>
                      <% elsif dog.female? %>
                        <i class="fa-solid fa-venus text-danger" style="font-size: 0.6rem;"></i>
                      <% end %>
                    </div>
                    <div class="text-secondary" style="font-size: 0.65rem;">
                      <%= dog.breed %> / <%= (Date.today.strftime('%Y%m%d').to_i - dog.birthday.strftime('%Y%m%d').to_i) / 10000 %>歳
                    </div>
                  </div>
                </div>
              <% end %>
            <% else %>
              <span class="text-muted small px-2">紐付けられた愛犬はいません</span>
            <% end %>
          </div>
        </div>

        <div class="card-body p-4 p-md-5">
          <div class="d-flex justify-content-between align-items-baseline mb-3 flex-wrap">
            <h2 class="fw-bold text-dark mb-0 me-3"><%= @review.title %></h2>
            <div class="d-flex align-items-center text-secondary small bg-light px-3 py-2 rounded-pill shadow-sm">
              <div class="d-flex align-items-center me-3 border-end pe-3">
                <i class="fa-solid fa-circle-user text-warning me-2 fs-5"></i>
                <span class="fw-bold text-dark"><%= @review.user.name %></span>
                <span class="ms-1">さんの投稿</span>
              </div>
              <div class="d-flex align-items-center">
                <i class="fa-solid fa-calendar-day me-2"></i>
                <%= @review.created_at.strftime('%Y年%m月%d日') %>
              </div>
            </div>
          </div>

          <div class="mb-4">
            <div class="badge border border-warning text-warning rounded-pill px-3 py-2">
              <i class="fa-solid fa-tag me-1 small"></i><%= @review.category %>
            </div>
          </div>

          <div class="review-body mb-5">
            <p class="text-dark" style="font-size: 1.1rem; line-height: 1.9; white-space: pre-wrap;"><%= @review.body %></p>
          </div>

          <div class="d-flex align-items-center justify-content-between bg-light p-3 rounded-4 shadow-sm mb-5">
            <div class="d-flex align-items-center">
              <span class="fw-bold text-secondary me-3 small">満足度：</span>
              <%= render 'static_rate', review: @review %>
            </div>

            <div class="d-flex align-items-center border-start ps-4">
              <% if @review.favorite_reviews_by?(current_user) %>
                <%= link_to review_favorite_reviews_path(@review), method: :delete, class: "text-decoration-none d-flex align-items-center gap-2" do %>
                  <i class="fas fa-heart fs-4 text-danger"></i>
                  <span class="fw-bold text-danger"><%= @review.favorite_reviews.count %></span>
                <% end %>
              <% else %>
                <%= link_to review_favorite_reviews_path(@review), method: :post, class: "text-decoration-none d-flex align-items-center gap-2 text-secondary" do %>
                  <i class="far fa-heart fs-4"></i>
                  <span class="fw-bold"><%= @review.favorite_reviews.count %></span>
                <% end %>
              <% end %>
            </div>
          </div>

          <hr class="my-4 opacity-25">

          <div class="d-flex justify-content-between align-items-center">
            <%= link_to reviews_path, class: "btn btn-outline-secondary rounded-pill px-4" do %>
              <i class="fa-solid fa-arrow-left me-1"></i>一覧へ
            <% end %>

            <% if @review.user_id == current_user.id %>
              <div>
                <%= link_to edit_review_path(@review.id), class: "btn btn-sm btn-outline-warning rounded-pill px-3 me-2" do %>
                  <i class="fa-solid fa-pen"></i> 編集
                <% end %>
                <%= link_to review_path(@review.id), method: :delete, data: { confirm: "本当に削除しますか？" }, class: "btn btn-sm btn-outline-danger rounded-pill px-3" do %>
                  <i class="fa-solid fa-trash"></i> 削除
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="comment-section">
        <h5 class="fw-bold mb-4">
          <i class="fa-solid fa-comments text-warning me-2"></i>コメント <%= @review.review_comments.count %>件
        </h5>

        <div class="mb-5">
          <% @review.review_comments.each do |review_comment| %>
            <div class="bg-white p-3 rounded-4 shadow-sm mb-3">
      
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-bold text-dark">
                  <i class="fa-solid fa-user-circle me-1"></i><%= review_comment.user.name %>
                </span>

                <% if review_comment.favorite_comments_by?(current_user) %>
                  <p>
                    <%= link_to review_comment_favorite_comments_path(review_comment), method: :delete do %>
                      <i class="fas fa-heart" aria-hidden="true" style="color: red;"></i>
                      <%= review_comment.favorite_comments.count %>
                    <% end %>
                  </p>
                <% else %>
                  <p>
                    <%= link_to review_comment_favorite_comments_path(review_comment), method: :post do %>
                      <i class="far fa-heart"></i>
                      <%= review_comment.favorite_comments.count %>
                    <% end %>
                  </p>
                <% end %>

                <div class="d-flex align-items-center">
                  <span class="small text-muted me-2" style="font-size: 0.75rem;">
                    <%= review_comment.created_at.strftime('%Y/%m/%d') %>
                  </span>

                  <% if review_comment.user == current_user %>
                    <%= link_to review_review_comment_path(review_comment.review, review_comment), 
                        method: :delete, 
                        class: "text-danger opacity-50 hover-opacity-100", 
                        style: "line-height: 1;" do %>
                      <i class="fa-solid fa-circle-xmark"></i>
                    <% end %>
                  <% end %>
                </div>
              </div>

              <p class="mb-0 text-secondary small text-start">
                <%= review_comment.comment %>
              </p>

            </div>
          <% end %>
        </div>


        <div class="card border-0 shadow-sm rounded-4 p-4 bg-light">
          <%= form_with model: [@review, @review_comment] do |f| %>
            <div class="mb-3">
              <%= f.label :comment, "コメントを投稿する", class: "form-label fw-bold small" %>
              <%= f.text_area :comment, rows: '3', class: "form-control border-0 rounded-3", placeholder: "愛犬家同士、優しくアドバイスや感想を伝えましょう！" %>
            </div>
            <div class="text-end">
              <%= f.submit "送信する", class: "btn btn-warning rounded-pill px-4 fw-bold shadow-sm" %>
            </div>
          <% end %>
        </div>
        </div>
      </div>
    </div>
  </div>
</div>