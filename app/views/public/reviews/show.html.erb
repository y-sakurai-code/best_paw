<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-9">

      <div class="text-center mb-4">
        <div class="bg-warning-subtle rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
          <i class="fa-solid fa-file-lines fa-2x text-warning"></i>
        </div>
        <p class="text-secondary small">愛犬との素敵な思い出をチェックしましょう</p>
      </div>

      <%# レビュー対象の愛犬を表示するヘッダーカード %>
      <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
        <div class="bg-warning-subtle p-3 border-bottom border-white">
          <div class="d-flex align-items-center mb-2 px-2">
            <i class="fa-solid fa-paw text-warning me-2"></i>
            <span class="text-warning-emphasis fw-bold small" style="letter-spacing: 0.1rem;">REVIEW TARGET DOGS</span>
          </div>
          
          <div class="d-flex flex-wrap gap-3 px-2">
            <% if @review.dogs.any? %>
              <% @review.dogs.each do |dog| %>
                <div class="d-flex align-items-center bg-white rounded-pill pe-3 py-1 shadow-sm border border-light">
                  <%# 犬の表示画像（なければデフォルトアイコン） %>
                  <% if dog.dog_image.attached? %>
                    <%= image_tag dog.dog_image, class: "rounded-circle border border-2 border-white", style: "width: 60px; height: 60px; object-fit: cover;" %>
                  <% else %>
                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center border border-2 border-white" style="width: 60px; height: 60px;">
                      <i class="fa-solid fa-dog text-secondary" style="font-size: 0.8rem;"></i>
                    </div>
                  <% end %>
                  
                  <div class="ms-2">
                    <div class="fw-bold text-dark" style="font-size: 0.75rem;">
                      <%= dog.name %> 
                      <% if dog.respond_to?(:male?) && dog.male? %>
                        <i class="fa-solid fa-mars text-primary" style="font-size: 0.6rem;"></i>
                      <% elsif dog.respond_to?(:female?) && dog.female? %>
                        <i class="fa-solid fa-venus text-danger" style="font-size: 0.6rem;"></i>
                      <% end %>
                    </div>
                    <%# 犬種と年齢計算の表示 %>
                    <div class="text-secondary" style="font-size: 0.65rem;">
                      <%= dog.breed %> / <%= (Date.today.strftime('%Y%m%d').to_i - dog.birthday.strftime('%Y%m%d').to_i) / 10000 %>歳
                    </div>
                  </div>
                </div>
              <% end %>
            <% else %>
              <span class="text-muted small px-2">紐付けられた愛犬はいません</span>
            <% end %>
          </div>
        </div>

        <%# ジャンルとグッズ（アイテム）名 %>
        <div class="card-body p-4 p-md-5">
          <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
            <div>
              <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                <span class="badge bg-warning text-dark fw-bold rounded-pill px-3 py-2">
                  <i class="fa-solid fa-folder-open me-1"></i><%= @review.genre&.name || "未設定" %>
                </span>
                <div class="text-secondary fw-bold ms-1">
                  <i class="fa-solid fa-cart-shopping me-1"></i><%= @review.item_name %>
                </div>
              </div>
              <h2 class="fw-bold text-dark mb-0"><%= @review.title %></h2>
            </div>

            <%# 投稿者名と投稿日をひとつまとめにした右上表示 %>
            <div class="d-flex align-items-center text-secondary small bg-light px-3 py-2 rounded-pill shadow-sm">
              <div class="d-flex align-items-center me-3 border-end pe-3">
                <i class="fa-solid fa-circle-user text-warning me-2 fs-5"></i>
                <span class="fw-bold text-dark"><%= @review.user.name %></span>
                <span class="ms-1 d-none d-sm-inline">さんの投稿</span>
              </div>
              <div class="d-flex align-items-center">
                <i class="fa-solid fa-calendar-day me-2"></i>
                <%= @review.created_at.strftime('%Y年%m月%d日') %>
              </div>
            </div>
          </div>

          <%# カテゴリ（タグ）表示 %>
          <% if @review.category.present? %>
            <div class="mb-4">
              <div class="badge border border-warning text-warning rounded-pill px-3 py-2">
                <i class="fa-solid fa-tag me-1 small"></i><%= @review.category %>
              </div>
            </div>
          <% end %>

          <%# レビュー本文：white-space: pre-wrap; で改行を反映 %>
          <div class="review-body mb-5 p-4 bg-light bg-opacity-10 rounded-4 border">
            <p class="text-dark mb-0" style="font-size: 1.05rem; line-height: 2; white-space: pre-wrap;"><%= @review.body %></p>
          </div>

          <%# 星評価(raty)といいねボタン %>
          <div class="d-flex align-items-center justify-content-between bg-light p-3 rounded-4 shadow-sm mb-5">
            <div class="d-flex align-items-center">
              <span class="fw-bold text-secondary me-3 small">満足度：</span>
              <%= render 'static_rate', review: @review %>
            </div>

            <%# いいね機能：ログインユーザーが既にいいねしているかで表示を分岐 %>
            <div class="d-flex align-items-center border-start ps-4">
              <% if @review.favorite_reviews_by?(current_user) %>
                <%= link_to review_favorite_reviews_path(@review), method: :delete, class: "text-decoration-none d-flex align-items-center gap-2" do %>
                  <i class="fas fa-heart fs-4 text-danger animate__animated animate__heartBeat"></i>
                  <span class="fw-bold text-danger"><%= @review.favorite_reviews.count %></span>
                <% end %>
              <% else %>
                <%= link_to review_favorite_reviews_path(@review), method: :post, class: "text-decoration-none d-flex align-items-center gap-2 text-secondary" do %>
                  <i class="far fa-heart fs-4"></i>
                  <span class="fw-bold"><%= @review.favorite_reviews.count %></span>
                <% end %>
              <% end %>
            </div>
          </div>

          <hr class="my-4 opacity-25">

          <%# 一覧に戻るボタン、投稿者本人のみ編集・削除を表示 %>
          <div class="d-flex justify-content-between align-items-center">
            <%= link_to reviews_path, class: "btn btn-outline-secondary rounded-pill px-4 fw-bold" do %>
              <i class="fa-solid fa-arrow-left me-1"></i>一覧へ戻る
            <% end %>

            <% if @review.user_id == current_user.id %>
              <div class="d-flex gap-2">
                <%= link_to edit_review_path(@review.id), class: "btn btn-outline-warning rounded-pill px-4 fw-bold shadow-sm" do %>
                  <i class="fa-solid fa-pen me-1"></i> 編集
                <% end %>
                <%= link_to review_path(@review.id), method: :delete, data: { confirm: "本当に削除しますすか？" }, class: "btn btn-outline-danger rounded-pill px-4 fw-bold shadow-sm" do %>
                  <i class="fa-solid fa-trash me-1"></i> 削除
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <%# ここからコメントセクション開始 %>
      <div class="mt-5 mb-4">
        <h5 class="fw-bold mb-3">
          <i class="fa-solid fa-comments text-warning me-2"></i>コメント <%= @review.review_comments.count %>件
        </h5>

        <%# コメントの表示 %>
        <% if @review.review_comments.any? %>
          <% @review.review_comments.each do |comment| %>
            <div class="card border-0 shadow-sm rounded-4 p-3 mb-3 bg-white">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="d-flex align-items-center">
                  <%# コメントしたユーザーの愛犬アイコン %>
                  <% if comment.user.dogs.any? && comment.user.dogs.first.dog_image.attached? %>
                    <%= image_tag comment.user.dogs.first.dog_image, class: "rounded-circle border border-1 border-light me-2", style: "width: 35px; height: 35px; object-fit: cover;" %>
                  <% else %>
                    <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center me-2 border" style="width: 35px; height: 35px;">
                      <i class="fa-solid fa-dog text-secondary" style="font-size: 0.8rem;"></i>
                    </div>
                  <% end %>
                  <span class="fw-bold small"><%= comment.user.name %></span>
                </div>

                <%# コメントへのいいねボタン %>
                <div class="d-flex flex-column align-items-end">
                  <div class="d-flex align-items-center gap-1 mb-1">
                    <% if comment.favorite_comments_by?(current_user) %>
                      <%= link_to review_review_comment_favorite_comments_path(@review, comment), method: :delete, class: "text-decoration-none text-danger small d-flex align-items-center gap-1" do %>
                        <i class="fas fa-heart"></i>
                        <span class="fw-bold"><%= comment.favorite_comments.count %></span>
                      <% end %>
                    <% else %>
                      <%= link_to review_review_comment_favorite_comments_path(@review, comment), method: :post, class: "text-decoration-none text-secondary small d-flex align-items-center gap-1" do %>
                        <i class="far fa-heart"></i>
                        <span class="fw-bold"><%= comment.favorite_comments.count %></span>
                      <% end %>
                    <% end %>
                  </div>

                  <span class="text-secondary" style="font-size: 0.7rem;">
                    <%= comment.created_at.strftime('%Y/%m/%d') %>
                  </span>
                </div>
              </div>
              <p class="text-dark mb-0 small" style="line-height: 1.6;"><%= comment.comment %></p>
              
              <%# コメント削除ボタン（投稿者本人のみ） %>
              <% if comment.user == current_user %>
                <div class="text-end">
                  <%= link_to review_review_comment_path(@review, comment), method: :delete, data: { confirm: "コメントを削除しますか？" }, class: "text-danger text-decoration-none small" do %>
                    <i class="fa-solid fa-trash-can"></i>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <p class="text-muted small ps-2">まだコメントはありません。最初のコメントを投稿してみましょう！</p>
        <% end %>

        <%# コメント投稿フォーム（ゲストログインは投稿不可） %>
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-light">
        <% if current_user.guest_user? %>
          <div class="alert alert-info mt-3">
            <i class="fa-solid fa-circle-info"></i> ゲストユーザーはコメントを投稿できません。
          </div>
        <% else %>
          <%= form_with model: [@review, @review_comment], local: true do |f| %>
            <div class="mb-3">
              <%= f.label :comment, "コメントを投稿する", class: "form-label fw-bold small" %>
              <%= f.text_area :comment, rows: '3', class: "form-control border-0 rounded-3", placeholder: "愛犬家同士、優しくアドバイスや感想を伝えましょう！" %>
            </div>
            <div class="text-end">
              <%= f.submit "送信する", class: "btn btn-warning rounded-pill px-4 fw-bold shadow-sm" %>
            </div>
          <% end %>
        <% end %>
      </div>
      </div>
    </div>
  </div>
</div>

