<div class="content">

  <h3>レビュータイトル</h3>
  <p><%= @review.title %></p>

  <h3>レビュー本文</h3>
  <p><%= @review.body %></p>

  <br>
  <%= link_to "Back", reviews_path %>
  <% if @review.user_id == current_user.id %>
    <%= link_to "Edit", edit_review_path(@review.id) %>
    <%= link_to "Destroy", review_path(@review.id), method: :delete, "data-confirm" => "Are you sure ?" %>
  <% end %>
</div>

<div class="content">
  <p>コメント件数：<%= @review.review_comments.count %></p>
  <% @review.review_comments.each do |review_comment| %>
    <%= review_comment.user.name %>
    <%= review_comment.created_at.strftime('%Y/%m/%d') %><%= review_comment.comment %>
    <% if review_comment.user == current_user %>
      <%= link_to "削除", review_review_comment_path(review_comment.review, review_comment), method: :delete %>
    <% end %>
  <% end %>
</div>
<div class="content">
  <%= form_with model: [@review, @review_comment] do |f| %>
    <%= f.text_area :comment, rows: '5', placeholder: "コメント" %>
    <br>
    <%= f.submit "送信する" %>
  <% end %>
</div>