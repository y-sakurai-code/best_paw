<div class="container py-5">
  <%# 検索ヘッダーエリア %>
  <div class="text-center mb-5">
    <h2 class="fw-bold">
      <i class="fa-solid fa-magnifying-glass text-warning me-2"></i>検索結果
    </h2>
    <p class="text-secondary">
      "<%= @word %>" の検索結果（<%= @range == "User" ? "ユーザー" : "レビュー" %>）
    </p>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-9">
      
      <% if @range == "User" %>
        <%# --- ユーザー検索結果（リスト形式） --- %>
        <div class="row row-cols-1 row-cols-md-2 g-3">
          <% @users.each do |user| %>
            <div class="col">
              <%= link_to user_path(user.id), class: "text-decoration-none" do %>
                <div class="card border-0 shadow-sm rounded-4 h-100 hover-shadow transition">
                  <div class="card-body d-flex align-items-center p-3">
                    <div class="bg-warning-subtle rounded-circle p-3 me-3">
                      <i class="fa-solid fa-user text-warning fs-4"></i>
                    </div>
                    <div>
                      <h5 class="fw-bold text-dark mb-0"><%= user.name %></h5>
                      <small class="text-muted">ユーザー詳細を見る</small>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

      <% else %>
        <%# --- レビュー検索結果（一覧と同じカード形式を少しスリムに） --- %>
        <div class="row row-cols-1 g-3">
          <% @reviews.each do |review| %>
            <div class="col">
              <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="row g-0 align-items-center">
                  <div class="col-md-3 bg-warning-subtle text-center py-4 py-md-5">
                    <i class="fa-solid fa-paw fa-3x text-white opacity-75"></i>
                  </div>
                  <div class="col-md-9">
                    <div class="card-body">
                      <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="fw-bold mb-0">
                          <%= link_to review.title, review_path(review.id), class: "text-dark text-decoration-none" %>
                        </h5>
                        <span class="small text-muted">
                          <i class="fa-solid fa-comment me-1"></i><%= review.review_comments.count %>
                        </span>
                      </div>
                      <p class="card-text text-secondary small line-clamp-2 mb-3">
                        <%= review.body %>
                      </p>
                      <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-muted">
                          <i class="fa-solid fa-user-circle me-1"></i><%= review.user.name %>
                        </span>
                        <%= link_to "詳しく見る", review_path(review.id), class: "btn btn-sm btn-warning rounded-pill px-3 fw-bold" %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <%# 結果がゼロの場合のフォロー %>
      <% if (@range == "User" && @users.empty?) || (@range == "Review" && @reviews.empty?) %>
        <div class="text-center py-5 bg-white rounded-4 shadow-sm mt-4">
          <i class="fa-solid fa-face-sad-tear fa-3x text-light mb-3"></i>
          <p class="text-secondary">一致する結果が見つかりませんでした。<br>別のキーワードで試してみてください。</p>
        </div>
      <% end %>

    </div>
  </div>
</div>

<style>
  .transition { transition: all 0.3s ease; }
  .hover-shadow:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important; }
</style>