<div class="container py-5">
  <div class="text-center mb-5">
    <h2 class="fw-bold">
      <i class="fa-solid fa-magnifying-glass text-warning me-2"></i>検索結果
    </h2>
    <p class="text-secondary">
      <% if @range == "Dog" %>
        犬種 <strong>"<%= @word %>"</strong>
      <% else %>
        キーワード <strong>"<%= @word %>"</strong>
      <% end %>
      （<%= @reviews.total_count %>件）
    </p>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-9">
      
      <% if @reviews.any? %>
        <div class="row row-cols-1 g-4">
          <% @reviews.each do |review| %>
            <div class="col">
              <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 transition hover-shadow">
                
                <div class="bg-warning-subtle p-3 border-bottom border-white shadow-inner">
                  <div class="d-flex align-items-center mb-2">
                    <i class="fa-solid fa-paw text-warning me-2"></i>
                    <span class="text-warning-emphasis fw-bold" style="font-size: 0.8rem; letter-spacing: 0.1rem;">FAMILY PROFILE</span>
                  </div>
                  
                  <div class="d-flex flex-wrap gap-4 px-2">
                    <% review.user.dogs.where(is_archived: false).each do |dog| %>
                      <div class="d-flex align-items-center bg-white rounded-pill pr-3 py-1 shadow-sm border border-light" style="padding-right: 15px;">
                        <%# 画像 %>
                        <% if dog.dog_image.attached? %>
                          <%= image_tag dog.dog_image, class: "rounded-circle border border-2 border-white", style: "width: 50px; height: 50px; object-fit: cover;" %>
                        <% else %>
                          <div class="rounded-circle bg-light d-flex align-items-center justify-content-center border border-2 border-white" style="width: 50px; height: 50px;">
                            <i class="fa-solid fa-dog text-secondary" style="font-size: 1rem;"></i>
                          </div>
                        <% end %>
                        
                        <%# 犬名と犬種（横並び） %>
                        <div class="ms-2">
                          <div class="fw-bold text-dark" style="font-size: 0.75rem;"><%= dog.name %></div>
                          <div class="<%= dog.breed.include?(@word) ? 'text-warning fw-bold' : 'text-secondary' %>" style="font-size: 0.7rem;">
                            <%= dog.breed %>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>

                <div class="card-body p-4">
                  <div class="row">
                    <div class="col-md-9">
                      <div class="mb-3">
                        <span class="badge bg-warning text-dark mb-2 fw-normal" style="font-size: 0.7rem;">レビュータイトル</span>
                        <h5 class="fw-bold text-dark mb-1">
                          <%= link_to review.title, review_path(review.id), class: "text-dark text-decoration-none" %>
                        </h5>
                      </div>
                      
                      <div class="mb-0">
                        <span class="badge bg-light text-secondary mb-2 fw-normal border" style="font-size: 0.7rem;">レビュー本文</span>
                        <p class="card-text text-secondary small mb-0" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.6;">
                          <%= review.body %>
                        </p>
                      </div>
                    </div>

                    <div class="col-md-3 d-flex align-items-end justify-content-end mt-3 mt-md-0">
                      <%= link_to review_path(review.id), class: "btn btn-warning rounded-pill px-4 fw-bold shadow-sm w-100 w-md-auto" do %>
                        詳しく見る <i class="fa-solid fa-chevron-right ms-1" style="font-size: 0.7rem;"></i>
                      <% end %>
                    </div>
                  </div>
                </div>

              </div>
            </div>
          <% end %>
          <div class="d-flex justify-content-center mt-5">
            <%= paginate @reviews, params: { range: @range, word: @word } %>
          </div>
        </div>
      <% else %>
        <%# ヒットしなかった場合 %>
        <div class="text-center py-5 bg-white rounded-4 shadow-sm">
          <p class="text-secondary mb-0">一致するレビューは見つかりませんでした。</p>
        </div>
      <% end %>

    </div>
  </div>
</div>

<style>
  .pagination .page-item.active .page-link {
    background-color: #ffc107;
    border-color: #ffc107;
    color: #fff;
  }
  .pagination .page-item .page-link {
    color: #856404;
  }
</style>