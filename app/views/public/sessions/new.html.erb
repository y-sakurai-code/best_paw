<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
        
        <div class="text-center mb-5">
          <div class="bg-warning-subtle rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
            <i class="fa-solid fa-right-to-bracket fa-2x text-warning"></i>
          </div>
          <h2 class="fw-bold text-dark">ログイン</h2>
          <p class="text-secondary small">おかえりなさい！<br>愛犬との素敵な出会いを続けましょう</p>
        </div>

        <%= form_with model: @user, url: user_session_path, local: true do |f| %>
          <%# メールアドレス %>
          <div class="mb-4">
            <%= f.label :email, "メールアドレス", class: "form-label fw-bold small" %>
            <div class="input-group">
              <span class="input-group-text bg-light border-0 rounded-start-3 text-secondary">
                <i class="fa-solid fa-envelope"></i>
              </span>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control bg-light border-0 rounded-end-3 py-2", placeholder: "example@bestpaw.com" %>
            </div>
          </div>

          <%# パスワード %>
          <div class="mb-3">
            <%= f.label :password, "パスワード", class: "form-label fw-bold small" %>
            <div class="input-group">
              <span class="input-group-text bg-light border-0 rounded-start-3 text-secondary">
                <i class="fa-solid fa-lock"></i>
              </span>
              <%= f.password_field :password, autocomplete: "current-password", class: "form-control bg-light border-0 rounded-end-3 py-2", placeholder: "••••••••" %>
            </div>
          </div>

          <%# ログイン状態を保持する %>
          <% if devise_mapping.rememberable? %>
            <div class="mb-4 form-check">
              <%= f.check_box :remember_me, class: "form-check-input" %>
              <%= f.label :remember_me, "次回から自動ログイン", class: "form-check-label small text-secondary" %>
            </div>
          <% end %>

          <%# ログインボタン %>
          <div class="d-grid mb-4">
            <%= f.submit "ログイン", class: "btn btn-warning btn-lg rounded-pill fw-bold shadow-sm py-2" %>
          </div>
        <% end %>

        <%# 共有リンク（新規登録・パスワード再設定など） %>
        <div class="text-center mt-3 pt-3 border-top border-light">
          <div class="small text-secondary mb-2">アカウントをお持ちでない方</div>
          <%= render "devise/shared/links" %>
        </div>

      </div>
    </div>
  </div>
</div>

<style>
  /* Deviseの共有リンク（青い下線）をサイトに合わせる微調整 */
  .text-center a {
    text-decoration: none;
    color: #ffc107; /* warning color */
    font-weight: bold;
    font-size: 0.9rem;
  }
  .text-center a:hover {
    text-decoration: underline;
  }
</style>