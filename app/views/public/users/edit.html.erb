<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
        
        <div class="text-center mb-4">
          <div class="bg-warning-subtle rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
            <i class="fa-solid fa-user-gear fa-2x text-warning"></i>
          </div>
          <h2 class="fw-bold">ユーザー情報の編集</h2>
          <p class="text-secondary small">アカウント情報を最新に更新しましょう</p>
        </div>

        <% if @user.errors.any? %>
          <div class="alert alert-danger border-0 rounded-4 shadow-sm mb-4">
            <div class="fw-bold mb-1 text-danger"><%= @user.errors.count %>件のエラーがあります</div>
            <ul class="mb-0 small text-danger">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with model: @user, local: true do |f| %>
          <div class="mb-4">
            <%= f.label :name, "ユーザーネーム", class: "form-label fw-bold" %>
            <%= f.text_field :name, class: "form-control form-control-lg bg-light border-0 rounded-3" %>
          </div>

          <div class="mb-4">
            <%= f.label :email, "メールアドレス", class: "form-label fw-bold" %>
            <%= f.email_field :email, class: "form-control form-control-lg bg-light border-0 rounded-3" %>
          </div>

          <div class="mb-4">
            <%= f.label :password, "新しいパスワード", class: "form-label fw-bold" %>
            <small class="text-muted d-block mb-2">※変更しない場合は空欄のままにしてください</small>
            <%= f.password_field :password, class: "form-control form-control-lg bg-light border-0 rounded-3", placeholder: "6文字以上" %>
          </div>

          <div class="d-grid gap-2 mt-5">
            <%= f.submit '変更を保存する', class: "btn btn-warning btn-lg rounded-pill fw-bold shadow-sm py-3" %>
            <%= link_to "マイページに戻る", users_mypage_path, class: "btn btn-link text-secondary text-decoration-none small" %>
          </div>
        <% end %>

        <hr class="my-5 opacity-25">

        <div class="text-center">
          <p class="small text-muted mb-2">Best Paw を退会される方はこちら</p>
          <%= link_to users_path(id: current_user.id), method: :delete, data: { confirm: "本当に退会しますか？投稿したレビューもすべて削除されます。" }, class: "btn btn-outline-danger btn-sm rounded-pill px-4" do %>
            <i class="fa-solid fa-user-xmark me-1"></i>退会手続きへ
          <% end %>
        </div>

      </div>
    </div>
  </div>
</div>