<div class="container py-5">
  <div class="row g-4">
    
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 overflow-hidden sticky-top" style="top: 20px;">
        <div class="bg-warning text-center py-5">
          <i class="fa-solid fa-circle-user fa-5x text-white"></i>
        </div>
        <div class="card-body p-4 text-center">
          <h4 class="fw-bold mb-1"><%= current_user.name %></h4>
          <p class="text-secondary small mb-4">Best Paw 会員</p>
          
          <div class="d-grid gap-2">
            <%= link_to user_path(current_user.id), class: "btn btn-outline-warning rounded-pill fw-bold" do %>
              <i class="fa-solid fa-gear me-1"></i>ユーザー情報詳細
            <% end %>
          </div>
        </div>
        <div class="card-footer bg-white border-0 p-4 pt-0">
          <div class="row text-center border-top pt-3">
            <div class="col">
              <div class="fw-bold text-warning fs-4"><%= @reviews.count %></div>
              <div class="small text-secondary">Reviews</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-8">
      <div class="d-flex align-items-center mb-4">
        <i class="fa-solid fa-list-ul text-warning fs-3 me-2"></i>
        <h3 class="fw-bold mb-0">あなたの投稿一覧</h3>
      </div>

      <% if @reviews.any? %>
        <div class="row row-cols-1 row-cols-md-2 g-3">
          <% @reviews.each do |review| %>
            <div class="col">
              <%= render 'public/reviews/review_card', review: review %>
            </div>
          <% end %>
        </div>
      <% else %>

        <div class="text-center py-5 bg-white rounded-4 shadow-sm">
          <i class="fa-solid fa-paw fa-3x text-light mb-3"></i>
          <p class="text-secondary">まだレビューを投稿していません。<br>愛犬のお気に入りグッズをシェアしてみませんか？</p>
          <%= link_to "レビューを投稿する", new_review_path, class: "btn btn-warning rounded-pill fw-bold" %>
        </div>
      <% end %>
    </div>

  </div>
</div>