<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      
      <div class="text-center mb-4">
        <h2 class="fw-bold text-warning">
          <i class="fa-solid fa-address-card me-2"></i>ユーザー情報詳細
        </h2>
        <p class="text-secondary small">ご登録いただいているアカウント情報です</p>
      </div>

      <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="bg-warning-subtle py-4 text-center">
          <i class="fa-solid fa-user-gear fa-4x text-white"></i>
        </div>

        <div class="card-body p-4 p-md-5">
          <%# ユーザーネーム %>
          <div class="mb-4 border-bottom pb-3">
            <label class="small text-secondary fw-bold mb-1">ユーザーネーム</label>
            <div class="fs-5 fw-bold text-dark">
              <i class="fa-solid fa-user me-2 text-warning"></i><%= current_user.name %>
            </div>
          </div>

          <%# メールアドレス %>
          <div class="mb-4 border-bottom pb-3">
            <label class="small text-secondary fw-bold mb-1">メールアドレス</label>
            <div class="fs-5 text-dark">
              <i class="fa-solid fa-envelope me-2 text-warning"></i><%= current_user.email %>
            </div>
          </div>

          <%# パスワード %>
          <div class="mb-4 border-bottom pb-3">
            <label class="small text-secondary fw-bold mb-1">パスワード</label>
            <div class="text-secondary">
              <i class="fa-solid fa-lock me-2 text-warning"></i>セキュリティ保護のため非表示
            </div>
          </div>

          
          <div class="d-grid gap-3 mt-5">
            <%= link_to edit_user_path(current_user.id), class: "btn btn-warning btn-lg rounded-pill fw-bold shadow-sm" do %>
              <i class="fa-solid fa-user-pen me-2"></i>ユーザー情報を編集する
            <% end %>
            
            <%= link_to users_mypage_path, class: "btn btn-outline-secondary rounded-pill" do %>
              <i class="fa-solid fa-arrow-left me-2"></i>マイページへ戻る
            <% end %>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>