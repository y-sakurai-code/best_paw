<div class="content">
<h3>ユーザー編集画面</h3>

<% if @user.errors.any? %>
  <%= @user.errors.count %>件のエラーが発生しました
  <ul>
    <% @user.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @user do |f| %>

  <h4>ユーザーネーム</h4>
  <%= f.text_field :name %>
  
  <h4>メールアドレス</h4>
  <%= f.text_area :email %>

  <h4>パスワード</h4>
  <%= f.text_area :password %>

  <br>
  
  <%= f.submit '保存' %>

  <br>
  <br>

  <%= link_to "退会", user_path(@user.id), method: :archive, "data-confirm" => "Are you sure ?" %>

  <br>
  <br>
  <%= link_to "Back", users_mypage_path %>
  
<% end %>
</div>